/* =========================================================================
   10. DYNAMIC SELF-DRAWING CONSTELLATION STAGE (SVG VECTOR ENGINE)
   ========================================================================= */
main:has(#arisCosmicConstellationStage)::before,
main:has(#arisCosmicConstellationStage)::after,
body:has(#arisCosmicConstellationStage) main::before,
body:has(#arisCosmicConstellationStage) main::after {
  display: none !important;
}

.aris-cosmic-stage {
  position: absolute;
  top: 8px;
  right: 28px;
  width: 300px;
  height: 180px;
  z-index: 8;
  pointer-events: none;
  transition: opacity 300ms ease;
}

.constellation-frame {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.constellation-svg {
  filter: drop-shadow(0 0 16px rgba(56, 189, 248, 0.75));
  overflow: visible;
}

.constellation-beam {
  filter: drop-shadow(0 0 8px rgba(126, 200, 245, 0.9));
}

.constellation-star-node {
  animation: starBurstIn 650ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes starBurstIn {
  0% { transform: scale(0); opacity: 0; }
  65% { transform: scale(1.6); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.alpha-star-pulse {
  animation: alphaPulseGlow 2.8s ease-in-out infinite;
  transform-origin: center;
}

@keyframes alphaPulseGlow {
  0%, 100% { transform: scale(1); opacity: 0.35; }
  50% { transform: scale(1.75); opacity: 0.85; }
}

.constellation-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
  padding: 5px 14px;
  background: rgba(10, 18, 36, 0.85);
  border: 1px solid rgba(147, 197, 253, 0.35);
  border-radius: 20px;
  backdrop-filter: blur(14px);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 18px rgba(47, 111, 237, 0.35);
  animation: badgeSlideIn 700ms cubic-bezier(0.22, 1, 0.36, 1) 300ms both;
}

@keyframes badgeSlideIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.constellation-pulse-beacon {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #38BDF8;
  box-shadow: 0 0 10px #38BDF8, 0 0 18px rgba(56, 189, 248, 0.8);
  animation: beaconPulse 1.6s ease-in-out infinite;
}

@keyframes beaconPulse {
  0%, 100% { transform: scale(0.85); opacity: 0.6; }
  50% { transform: scale(1.35); opacity: 1; }
}

.constellation-name-label {
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.26em;
  color: #E0F2FE;
  text-transform: uppercase;
  text-shadow: 0 0 12px rgba(56, 189, 248, 0.7);
}

@media (max-width: 991px) {
  .aris-cosmic-stage { display: none; }
}

/* =========================================================================
   11. LIVING COSMOS STARFIELD CANVAS
   ========================================================================= */
.aris-cosmos-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 0;
  opacity: 0.95;
}

body > * {
  position: relative;
  z-index: 1;
}

/* =========================================================================
   12. CELESTIAL ICONS & ORBITAL HOUSINGS (NO BORING DEFAULT ICONS)
   ========================================================================= */
.navbar .nav-link svg,
.navbar-brand svg {
  filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.45));
  transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.navbar .nav-link:hover svg {
  filter: drop-shadow(0 0 12px rgba(126, 200, 245, 0.85));
  transform: scale(1.18) rotate(3deg);
  color: #7EC8F5 !important;
}

.navbar .nav-link.active svg {
  filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.8));
  color: #FFFFFF !important;
}

/* Button icons with glowing starlight */
.btn svg {
  filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.4));
  transition: transform 180ms ease, filter 180ms ease;
}

.btn:hover svg {
  filter: drop-shadow(0 0 9px rgba(126, 200, 245, 0.9));
  transform: scale(1.12);
}

/* Orbital Glass Icon Housings */
.cosmic-icon-housing,
.telemetry-icon-box,
.launchpad-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: radial-gradient(circle at 35% 35%, rgba(56, 189, 248, 0.24) 0%, rgba(13, 21, 39, 0.8) 100%);
  border: 1px solid rgba(147, 197, 253, 0.30);
  box-shadow: 0 0 20px rgba(37, 99, 235, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  color: #7EC8F5;
  transition: all 260ms cubic-bezier(0.22, 1, 0.36, 1);
  flex-shrink: 0;
}

.telemetry-pill:hover .telemetry-icon-box,
.launchpad-card:hover .launchpad-icon {
  transform: scale(1.1) rotate(-4deg);
  border-color: rgba(147, 197, 253, 0.6);
  box-shadow: 0 0 28px rgba(56, 189, 248, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  color: #FFFFFF;
}

.telemetry-icon-box svg,
.launchpad-icon svg {
  width: 22px;
  height: 22px;
  filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6));
}

/* =========================================================================
   13. MISSION TELEMETRY STRIP & LAUNCHPAD BENTO GRID (ZERO DEAD SPACE)
   ========================================================================= */
.dash-telemetry-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}

.telemetry-pill {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  background: linear-gradient(135deg, rgba(16, 25, 45, 0.72) 0%, rgba(9, 15, 30, 0.88) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-top: 1px solid rgba(147, 197, 253, 0.25);
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(14px);
  transition: all 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.telemetry-pill:hover {
  transform: translateY(-2px);
  border-color: rgba(147, 197, 253, 0.45);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.55), 0 0 24px rgba(47, 111, 237, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.telemetry-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.telemetry-label {
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 11px;
  font-weight: 550;
  letter-spacing: 0.04em;
  color: #8BA2C4;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.telemetry-value {
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #F0F6FF;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.telemetry-tag {
  font-family: 'Inter', system-ui, sans-serif;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 20px;
  background: rgba(56, 189, 248, 0.14);
  border: 1px solid rgba(56, 189, 248, 0.3);
  color: #7EC8F5;
}

.telemetry-tag.tag-new {
  background: rgba(52, 211, 153, 0.14);
  border-color: rgba(52, 211, 153, 0.35);
  color: #86EFAC;
}

.telemetry-tag.tag-growth {
  background: rgba(245, 158, 11, 0.14);
  border-color: rgba(245, 158, 11, 0.35);
  color: #FDE047;
}

.pulse-beacon-inline {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #34D399;
  box-shadow: 0 0 10px #34D399;
  animation: beaconPulse 1.8s ease-in-out infinite;
}

/* Launchpad Bento Grid */
.launchpad-bento-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 24px;
  width: 100%;
}

.launchpad-card {
  display: flex;
  flex-direction: column;
  padding: 24px;
  border-radius: 18px;
  background: linear-gradient(145deg, rgba(16, 25, 45, 0.75) 0%, rgba(9, 15, 30, 0.92) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-top: 1px solid rgba(147, 197, 253, 0.28);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(16px);
  transition: all 260ms cubic-bezier(0.22, 1, 0.36, 1);
  text-align: left;
}

.launchpad-card:hover {
  transform: translateY(-4px);
  border-color: rgba(147, 197, 253, 0.5);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6), 0 0 32px rgba(47, 111, 237, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.launchpad-icon {
  margin-bottom: 16px;
}

.launchpad-card h6 {
  font-family: 'Space Grotesk', system-ui, sans-serif !important;
  font-size: 16px;
  font-weight: 700;
  color: #FFFFFF;
  margin: 0 0 8px;
}

.launchpad-card p {
  font-size: 13px;
  color: #94A4BA;
  line-height: 1.6;
  margin: 0 0 20px;
  flex-grow: 1;
}

.launchpad-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 13px;
  font-weight: 650;
  color: #7EC8F5;
  text-decoration: none;
  transition: all 180ms ease;
}

.launchpad-link svg {
  width: 15px;
  height: 15px;
  transition: transform 180ms ease;
}

.launchpad-card:hover .launchpad-link {
  color: #FFFFFF;
}

.launchpad-card:hover .launchpad-link svg {
  transform: translateX(4px);
}

@media (max-width: 1200px) {
  .dash-telemetry-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 767px) {
  .dash-telemetry-strip {
    grid-template-columns: minmax(0, 1fr);
  }
  .launchpad-bento-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

/* =========================================================================
   14. DESKTOP VIEWPORT DENSITY & ZERO DEAD SPACE SCALING
   ========================================================================= */
@media (min-width: 1200px) {
  .container,
  .container-lg,
  .container-xl,
  .container-xxl,
  .dashboard-page,
  .cosmos-page-container {
    max-width: 1380px !important;
    width: 95% !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }
}

@media (min-width: 1500px) {
  .container,
  .container-lg,
  .container-xl,
  .container-xxl,
  .dashboard-page,
  .cosmos-page-container {
    max-width: 1460px !important;
    width: 94% !important;
  }
}

/* =========================================================================
   14. SỬA V2: BỀ NGANG, MÀU, VÀ HAI LỖI LAYOUT

   Ba thứ khiến workspace vẫn không đứng cùng hệ với trang đăng nhập:
   nội dung bị kéo rộng tới 1380–1460px nên loãng, bảng màu có gradient
   cầu vồng và chữ gradient, và trường sao chạy ngay sau vùng đọc. Trang
   auth không có thứ nào trong ba thứ đó — nó chỉ có một màu brand, một
   nền mực, và ánh sáng dùng rất tiết kiệm.
   ========================================================================= */

/* ---- 14.1 Một bề ngang duy nhất --------------------------------------
   1380px (và 1460px trên màn rộng) là quá rộng cho một cột đọc: mắt phải
   quét quá xa và mọi thứ trở nên thưa. 1200px là mức các workspace dữ
   liệu thường dừng lại, và nó khớp với 1280px vốn đã dùng ở Jobs/Company. */
@media (min-width: 1200px) {
  .container, .container-lg, .container-xl, .container-xxl,
  .aris-container, .dashboard-page, .cosmos-page-container {
    max-width: 1200px !important;
    width: 100% !important;
    padding-left: 24px !important;
    padding-right: 24px !important;
  }
}

@media (min-width: 1500px) {
  .container, .container-lg, .container-xl, .container-xxl,
  .aris-container, .dashboard-page, .cosmos-page-container {
    max-width: 1200px !important;
    width: 100% !important;
  }
}

/* ---- 14.2 Trường sao lùi ra sau ---------------------------------------
   Canvas đang ở opacity .95 ngay dưới toàn bộ nội dung, nên chữ nằm trên
   nhiễu. Giữ bầu trời, nhưng hạ xuống mức của một phông nền thật. */
.aris-cosmos-canvas {
  opacity: .34 !important;
}

/* Một lớp mực mỏng dưới vùng nội dung để chữ không bao giờ nằm trực tiếp
   trên sao. Đặt sau canvas, trước nội dung. */
body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 60% 70% at 50% 42%, rgba(9, 13, 22, .86) 0%,
                    rgba(9, 13, 22, .55) 55%, transparent 100%);
}

/* ---- 14.3 Bỏ chữ gradient ---------------------------------------------
   Tiêu đề đổ màu trắng sang xanh là thứ trang auth không hề dùng. Một
   tiêu đề đặc, một màu brand cho CTA — đó mới là chỗ màu được phép xuất hiện. */
.cosmos-gradient-text,
.dashboard-heading .cosmos-gradient-text,
.cosmos-page-title .cosmos-gradient-text {
  background: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  -webkit-text-fill-color: currentColor !important;
  color: #EDF2F9 !important;
}

/* ---- 14.4 Eyebrow phải xuống dòng -------------------------------------
   Trên Jobs và Profile, nhãn nhỏ đang nằm cùng dòng với <h1> nên hai thứ
   dính vào nhau: "ARIS CAREER STUDIOCơ hội phù hợp với bạn". */
.cosmos-page-eyebrow,
.dashboard-eyebrow,
.profile-eyebrow {
  display: block !important;
  width: fit-content !important;
  margin-bottom: 10px !important;
}

.cosmos-page-head-inner > h1,
.cosmos-page-title {
  display: block !important;
  margin-top: 0 !important;
}

/* Phụ đề là một câu, không phải nhãn: chữ hoa toàn bộ ở cỡ câu đọc rất mệt. */
.cosmos-page-sub,
.dashboard-subline,
.dashboard-heading p {
  text-transform: none !important;
  letter-spacing: .004em !important;
  font-size: 14px !important;
  color: rgba(198, 213, 234, .74) !important;
}

/* ---- 14.5 Ảnh bìa hồ sơ ------------------------------------------------
   Ảnh bìa là nội dung của người dùng nên không thay, nhưng để nguyên độ
   bão hoà thì một dải cầu vồng sẽ là thứ chói nhất trên cả trang. Hạ bão
   hoà và độ sáng để nó nằm trong bảng màu. */
.profile-cover {
  filter: saturate(.34) brightness(.56) contrast(1.04) !important;
}

/* ---- 14.6 Ánh sáng tiết kiệm lại --------------------------------------
   Hào quang cyan trên mọi hộp icon làm giao diện đọc ra là đồ chơi. Auth
   chỉ cho ánh sáng xuất hiện ở đúng chỗ đang được chú ý. */
.cosmic-icon-housing, .telemetry-icon-box, .launchpad-icon {
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06) !important;
  border: 1px solid rgba(178, 212, 255, .14) !important;
  background: rgba(146, 186, 255, .045) !important;
}

.cosmic-icon-housing i, .telemetry-icon-box i, .launchpad-icon i,
.cosmic-icon-housing svg, .telemetry-icon-box svg, .launchpad-icon svg {
  filter: none !important;
  color: rgba(186, 212, 245, .92) !important;
  stroke-width: 1.5 !important;
}

.telemetry-pill:hover .telemetry-icon-box,
.launchpad-card:hover .launchpad-icon {
  border-color: rgba(190, 222, 255, .40) !important;
  background: rgba(146, 186, 255, .085) !important;
}

/* Ô telemetry giờ là lối tắt điều hướng, nên phải cư xử như một liên kết. */
a.telemetry-pill { text-decoration: none !important; }
a.telemetry-pill:hover { transform: translateY(-2px) !important; }

/* ---- 14.7 Nhãn màu phải đọc được --------------------------------------
   "Dành riêng cho bạn" đang là chữ sáng trên nền vàng nhạt — gần như
   không đọc nổi. Mọi nhãn màu về cùng một công thức: nền rất nhạt, chữ
   đậm cùng tông, viền mảnh. */
.badge.bg-warning, .badge.text-bg-warning, .tag-new, .telemetry-tag {
  background: rgba(223, 194, 141, .14) !important;
  color: #F0D9A8 !important;
  border: 1px solid rgba(223, 194, 141, .30) !important;
  font-weight: 500 !important;
}

.badge.bg-success, .badge.text-bg-success, .tag-growth {
  background: rgba(143, 205, 178, .14) !important;
  color: #A8DCC3 !important;
  border: 1px solid rgba(143, 205, 178, .30) !important;
}

.badge.bg-primary, .badge.text-bg-primary, .badge.bg-info {
  background: rgba(118, 160, 235, .16) !important;
  color: #BCD5F7 !important;
  border: 1px solid rgba(118, 160, 235, .32) !important;
}

/* ---- 14.8 Khối tiêu đề hồ sơ có nền riêng ------------------------------
   Header gradient xanh bão hoà ở thẻ hồ sơ Dashboard là mảng màu mạnh
   nhất trên trang mà không mang thông tin gì. */
.cosmos-profile-hero, .rail-profile-header, .profile-rail-cover {
  background: linear-gradient(160deg, #182334 0%, #121b2a 100%) !important;
  border-bottom: 1px solid rgba(178, 212, 255, .12) !important;
}

/* ---- 14.9 Nhãn Bootstrap biến thể "-subtle" ---------------------------
   "Dành riêng cho bạn" dùng bg-warning-subtle + text-warning-emphasis.
   Bootstrap tính hai biến đó từ bảng màu sáng, nên trên nền mực nó thành
   chữ nhạt trên nền nhạt — gần như không đọc được. Ép cả họ -subtle về
   cùng công thức đã dùng cho nhãn màu ở trên. */
.badge[class*="bg-warning-subtle"] {
  background: rgba(223, 194, 141, .14) !important;
  color: #F2DCAE !important;
  border-color: rgba(223, 194, 141, .34) !important;
}

.badge[class*="bg-success-subtle"] {
  background: rgba(143, 205, 178, .14) !important;
  color: #AEE0C7 !important;
  border-color: rgba(143, 205, 178, .34) !important;
}

.badge[class*="bg-primary-subtle"], .badge[class*="bg-info-subtle"] {
  background: rgba(118, 160, 235, .16) !important;
  color: #C3DAF9 !important;
  border-color: rgba(118, 160, 235, .34) !important;
}

.badge[class*="bg-secondary-subtle"], .badge[class*="bg-light"] {
  background: rgba(200, 216, 240, .10) !important;
  color: #C7D5E8 !important;
  border-color: rgba(200, 216, 240, .22) !important;
}

.badge[class*="bg-danger-subtle"] {
  background: rgba(237, 170, 170, .14) !important;
  color: #F0BDBD !important;
  border-color: rgba(237, 170, 170, .34) !important;
}

/* =========================================================================
   15. CHUYỂN ĐỘNG CÓ LÝ DO

   Mục tiêu ban đầu không phải là làm giao diện "hoạt hình hoá". Một vòng
   sáng đập 2.8 giây một lần, mãi mãi, không nói lên điều gì: mắt học xong
   nó trong ba giây rồi coi như nhiễu, và nó chạy cả khi người dùng đang
   đọc. Ở đây chuyển động chỉ xuất hiện khi CÓ CHUYỆN XẢY RA, và cú "bùng
   nổ" được dồn hết vào chòm sao của trang — đúng một chỗ, đúng một lần.
   ========================================================================= */

/* ---- 15.1 Tắt hai vòng lặp trang trí ---------------------------------- */
.constellation-star-node,
.alpha-star-pulse,
.pulse-beacon-inline,
[class*="beacon"] {
  animation: none !important;
}

/* Ngôi sao alpha vẫn sáng hơn các sao khác — bằng kích thước và độ sáng,
   không bằng việc nó nhấp nháy liên tục. */
.constellation-star-node,
.alpha-star-pulse {
  filter: drop-shadow(0 0 5px rgba(126, 200, 245, .45));
}

/* Sao alpha vẫn là sao sáng nhất của hình, chỉ là nó đứng yên. */
.alpha-star-pulse {
  filter: drop-shadow(0 0 9px rgba(160, 215, 255, .72));
}

/* ---- 15.2 Chòm sao phản ứng khi có sự kiện thật ------------------------
   `.is-reacting` do script gắn vào đúng lúc: gửi form, lưu thành công,
   bật/tắt một trạng thái, hoặc có toast. Hết hoạt cảnh thì gỡ ra. */
.constellation-frame .constellation-beam {
  transition: stroke-width 240ms cubic-bezier(.22, 1, .36, 1),
              opacity 240ms cubic-bezier(.22, 1, .36, 1);
}

.constellation-frame.is-reacting .constellation-beam {
  animation: beamSurge 760ms cubic-bezier(.22, 1, .36, 1) both;
}

.constellation-frame.is-reacting .constellation-beam:nth-of-type(2) {
  animation-delay: 90ms;
}

@keyframes beamSurge {
  0%   { opacity: .55; stroke-width: 1; }
  38%  { opacity: 1;   stroke-width: 2.1; }
  100% { opacity: .55; stroke-width: 1; }
}

/* Các sao sáng lên lần lượt dọc theo hình, nên mắt đọc được HƯỚNG của cú
   phản hồi thay vì thấy cả cụm chớp một lúc. */
.constellation-frame.is-reacting circle {
  animation: starFlare 620ms cubic-bezier(.22, 1, .36, 1) both;
}

.constellation-frame.is-reacting circle:nth-of-type(1)  { animation-delay: 0ms; }
.constellation-frame.is-reacting circle:nth-of-type(2)  { animation-delay: 55ms; }
.constellation-frame.is-reacting circle:nth-of-type(3)  { animation-delay: 110ms; }
.constellation-frame.is-reacting circle:nth-of-type(4)  { animation-delay: 165ms; }
.constellation-frame.is-reacting circle:nth-of-type(5)  { animation-delay: 220ms; }
.constellation-frame.is-reacting circle:nth-of-type(6)  { animation-delay: 275ms; }
.constellation-frame.is-reacting circle:nth-of-type(7)  { animation-delay: 330ms; }
.constellation-frame.is-reacting circle:nth-of-type(n+8) { animation-delay: 385ms; }

@keyframes starFlare {
  0%   { transform: scale(1);    opacity: .85; }
  40%  { transform: scale(1.75); opacity: 1; }
  100% { transform: scale(1);    opacity: .85; }
}

.constellation-frame circle {
  transform-box: fill-box;
  transform-origin: center;
}

/* ---- 15.3 Chiều sâu, không phải nảy ------------------------------------
   Nút và card phản hồi bằng ánh sáng và độ cao. Không nảy, không giật,
   không xoay — những thứ đó là cái làm giao diện đọc ra như đồ chơi. */
.btn:active, .telemetry-pill:active, .launchpad-card:active {
  transform: translateY(1px) scale(.994) !important;
  transition-duration: 90ms !important;
}

/* Trạng thái đang xử lý: nút tối đi và khoá lại, thay vì thêm một spinner
   quay mãi bên cạnh chữ. */
.btn[disabled], .btn.is-busy {
  opacity: .62 !important;
  cursor: progress !important;
}

/* ---- 15.4 Reduced motion ---------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
  .constellation-frame.is-reacting .constellation-beam,
  .constellation-frame.is-reacting circle {
    animation: none !important;
  }
}

/* =========================================================================
   16. CHIỀU SÂU CHÒM SAO, MODAL, VÀ MẬT ĐỘ DASHBOARD/JOBS
   ========================================================================= */

/* ---- 16.1 Badge tên chòm sao không còn trễ ----------------------------
   Nó đợi 300ms rồi mới chạy 700ms, nên tên chòm sao xuất hiện gần một
   giây sau khi hình đã vẽ xong — đủ lâu để đọc ra là lỗi chứ không phải
   nhịp. Giờ nó vào cùng nhịp cuối của hình. */
.constellation-badge {
  animation-delay: 60ms !important;
  animation-duration: 420ms !important;
}

/* ---- 16.2 Chat: không có chỗ cho chòm sao -----------------------------
   Cửa sổ hội thoại chiếm toàn bộ chiều cao; hình và badge đang đè lên
   header và lên chính bong bóng tin nhắn. */
body:has(#conversationList) .constellation-frame,
body:has(.messenger-shell) .constellation-frame,
body:has(#threadPane) .constellation-frame {
  display: none !important;
}

/* ---- 16.3 Chiều sâu thật cho chòm sao ---------------------------------
   Trước: mọi sao cùng một độ sáng, mọi nét cùng một độ đậm → phẳng.
   Giờ: quầng sáng phân tầng theo kích thước, nét nối mảnh dần về phía xa,
   và một vầng tinh vân rất mờ phía sau để hình có nền chứ không lơ lửng. */
.constellation-frame {
  position: relative;
  isolation: isolate;
}

.constellation-frame::before {
  content: "";
  position: absolute;
  inset: -18% -12% -22% -12%;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(ellipse 58% 62% at 62% 38%, rgba(64, 124, 220, .16) 0%,
                    rgba(40, 80, 170, .07) 45%, transparent 72%);
  filter: blur(14px);
}

/* Sao gần: lõi cứng, quầng rộng. Sao xa: nhỏ, mờ, không quầng. */
.constellation-star-node {
  transition: transform 120ms linear;
}

.constellation-star-node circle:first-child {
  opacity: .55;
}

.constellation-beam {
  transition: transform 120ms linear,
              stroke-width 240ms cubic-bezier(.22, 1, .36, 1),
              opacity 240ms cubic-bezier(.22, 1, .36, 1);
  stroke: url(#constellationBeamGrad);
  opacity: .62;
}

.constellation-beam:nth-of-type(even) {
  opacity: .38;     /* nhánh ở xa nhạt hơn — đây là tín hiệu chiều sâu */
}

/* Ngôi sao sáng nhất có tia nhiễu xạ như ảnh chụp thiên văn thật, thay cho
   cái vòng phồng/xẹp liên tục đã gỡ ở mục 15. */
.alpha-star-pulse {
  opacity: .30 !important;
}

/* ---- 16.4 Modal: phải có cạnh, nếu không nó đọc ra là "màn hình đen" ---
   Backdrop tối 50% phủ lên một trang vốn đã tối, mà dialog thì không có
   viền hay bóng đổ nào, nên không phân biệt được đâu là hộp thoại. */
.modal-backdrop, .modal-backdrop.show {
  background: radial-gradient(ellipse 80% 70% at 50% 45%,
              rgba(5, 9, 20, .58) 0%, rgba(3, 6, 14, .78) 100%) !important;
  opacity: 1 !important;
  /* Không dùng backdrop-filter ở đây: nó làm nhoè cả chính hộp thoại nằm
     phía trên, không chỉ nền phía sau. Lớp tối gradient đã đủ tách lớp. */
}

/* Trong giao diện tối, "nổi lên" nghĩa là SÁNG HƠN nền, không phải tối hơn.
   Bản trước dùng #16202f→#0f1724, gần như trùng giá trị với trang đã bị
   backdrop làm tối, nên không thấy cạnh hộp thoại ở đâu — và đó chính là
   cảm giác "màn hình đen". */
.modal-content {
  background: linear-gradient(162deg, #22304a 0%, #1a2538 100%) !important;
  border: 1px solid rgba(190, 222, 255, .34) !important;
  border-radius: 16px !important;
  box-shadow:
    0 32px 80px -24px rgba(0, 0, 0, .9),
    0 0 0 1px rgba(255, 255, 255, .03) inset,
    0 0 60px -30px rgba(96, 156, 255, .55) !important;
  overflow: hidden !important;
}

.modal-header, .modal-footer {
  border-color: rgba(178, 212, 255, .12) !important;
  background: rgba(146, 186, 255, .028) !important;
}

.modal-title, .modal-content h5, .modal-content h4 {
  font-family: 'Space Grotesk', Inter, sans-serif !important;
  letter-spacing: -.018em !important;
  color: #EDF2F9 !important;
}

.modal-content .btn-close {
  filter: invert(1) grayscale(1) brightness(1.6) !important;
  opacity: .55 !important;
}

.modal-content .btn-close:hover { opacity: 1 !important; }

/* ---- 16.5 Dashboard & Jobs: bớt trống, tăng sức hút -------------------
   Hai trang này bị chê trống vắng. Nguyên nhân đo được: khoảng cách dọc
   quá lớn giữa các khối, và card không có gì dẫn mắt — không điểm neo,
   không phân cấp trong chính nó. */

/* Nhịp dọc chặt lại. */
.dashboard-page > .row, .dashboard-page > div > .row { row-gap: 18px !important; }
.feed-composer-card { margin-bottom: 18px !important; }
.cosmos-page-head { padding-bottom: 14px !important; margin-bottom: 18px !important; }

/* Mỗi card có một điểm neo sáng ở cạnh trái — mắt bắt được hàng, và khi
   hover thì điểm neo kéo dài ra thành một vạch. Đây là cùng ngôn ngữ với
   nét nối giữa hai ngôi sao. */
.card, .card-aris, .aris-card { position: relative; overflow: hidden; }

.card::before, .card-aris::before, .aris-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22px;
  width: 2px;
  height: 0;
  border-radius: 0 2px 2px 0;
  background: linear-gradient(180deg, rgba(126, 200, 245, .95), rgba(47, 111, 237, .35));
  transition: height 320ms cubic-bezier(.22, 1, .36, 1), opacity 320ms;
  opacity: 0;
  pointer-events: none;
}

.card:hover::before, .card-aris:hover::before, .aris-card:hover::before {
  height: calc(100% - 44px);
  opacity: 1;
}

/* Thẻ việc làm: lương là thông tin người ta tìm trước nhất, nên nó được
   quyền nổi hơn phần còn lại. */
.card .badge[class*="bg-success-subtle"] {
  font-weight: 600 !important;
  font-size: 12.5px !important;
}

/* Khối bento ở empty state: cho nó chiều sâu thay vì ba ô phẳng cạnh nhau. */
.launchpad-card {
  background: linear-gradient(158deg, rgba(23, 33, 50, .92) 0%, rgba(15, 23, 36, .92) 100%) !important;
  border: 1px solid rgba(178, 212, 255, .13) !important;
  border-radius: 14px !important;
  transition: transform 220ms cubic-bezier(.22, 1, .36, 1),
              border-color 220ms, box-shadow 220ms !important;
}

.launchpad-card:hover {
  transform: translateY(-3px) !important;
  border-color: rgba(190, 222, 255, .40) !important;
  box-shadow: 0 18px 44px -22px rgba(0, 0, 0, .95),
              0 0 30px -16px rgba(126, 200, 245, .6) !important;
}

/* Lối tắt trên Dashboard: đang là bốn ô chữ nhật đều nhau, thiếu điểm nhấn.
   Ô đầu là việc người dùng nên làm trước, nên nó được tô sáng hơn. */
.dash-telemetry-strip a.telemetry-pill:first-child {
  border-color: rgba(160, 200, 255, .34) !important;
  background: linear-gradient(160deg, rgba(47, 111, 237, .16), rgba(20, 40, 90, .10)) !important;
}

/* ---- 16.6 Reduced motion --------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
  .card::before, .card-aris::before, .aris-card::before { display: none; }
  .constellation-star-node, .constellation-beam { transition: none !important; }
}

/* Vạch sáng ở mép trên: dấu hiệu quen thuộc của một mặt phẳng được nâng lên. */
.modal-content::before {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(190, 222, 255, .55), transparent);
  pointer-events: none;
  z-index: 2;
}

/* Hộp thoại nâng cấp chia hai nửa nhưng không có gì ngăn, nên hai phần
   dính vào nhau thành một khối chữ. */
.modal-body > .row > [class*="col-"]:first-child,
.modal-content > .row > [class*="col-"]:first-child {
  border-right: 1px solid rgba(190, 222, 255, .12);
}

.modal-content .form-control,
.modal-content .form-select {
  background: rgba(8, 14, 28, .55) !important;
  border-color: rgba(190, 222, 255, .20) !important;
}

/* =========================================================================
   17. CỘT CHẾT, MẬT ĐỘ THẺ VIỆC LÀM, VÀ CHÒM SAO ĐẸP HƠN
   ========================================================================= */

/* ---- 17.1 Cột chết — nguyên nhân thật của cảm giác "quá trống" --------
   Đo trên bản đang chạy: Dashboard cao 4100px nhưng cột phải dừng ở ~620px,
   để lại gần 3500px cột rỗng. Jobs cao 2378px, bộ lọc trái dừng ở ~620px.
   Không phải thiếu component — mà là các cột không đi theo người đọc.  */
.col-lg-3 > .sticky-top,
.col-xl-3 > .sticky-top,
.col-lg-4 > .sticky-top {
  position: sticky !important;
  top: 88px !important;
  max-height: calc(100vh - 104px);
  overflow-y: auto;
  scrollbar-width: thin;
}

/* Bộ lọc của Jobs không hề có sticky — thêm vào. */
.filter-sidebar-card {
  position: sticky !important;
  top: 88px !important;
}

/* Rail phụ của Dashboard đi theo cùng nhịp. */
.dashboard-page [class*="col-lg-4"] > *:first-child,
.dashboard-page [class*="col-xl-4"] > *:first-child {
  position: sticky;
  top: 88px;
}

.col-lg-3 > .sticky-top::-webkit-scrollbar,
.col-xl-3 > .sticky-top::-webkit-scrollbar { width: 6px; }
.col-lg-3 > .sticky-top::-webkit-scrollbar-thumb,
.col-xl-3 > .sticky-top::-webkit-scrollbar-thumb {
  background: rgba(178, 212, 255, .18); border-radius: 999px;
}

/* ---- 17.2 Thẻ việc làm: đặc hơn, có phân cấp ------------------------- */
/* Trước: mỗi thẻ cao ~190px cho 6 dòng thông tin, tất cả cùng một sức nặng
   nên bảy thẻ đọc ra y hệt nhau. */
.card .badge, .card .cosmos-chip {
  font-size: 11.5px !important;
  padding: 3px 9px !important;
}

/* Chức danh là thứ người ta quét trước, cho nó quyền nặng hơn hẳn. */
.card h5, .card h6, .card .fw-bold:first-of-type {
  font-family: 'Space Grotesk', Inter, sans-serif !important;
  letter-spacing: -.015em !important;
}

/* Mức lương: thông tin quyết định, nên là điểm sáng thứ hai sau chức danh. */
.card .badge[class*="bg-success-subtle"] {
  font-size: 13px !important;
  padding: 5px 11px !important;
  letter-spacing: .005em !important;
}

/* Hàng chip meta lùi xuống một bậc để không tranh với hai thứ trên. */
.card .badge[class*="bg-secondary-subtle"],
.card .badge[class*="bg-light"] {
  opacity: .78;
}

/* ---- 17.3 Chòm sao đẹp hơn ------------------------------------------
   Ba chi tiết tách "chấm trắng" khỏi "ngôi sao": lõi cứng, quầng phân
   tầng, và tia nhiễu xạ. Hai cái đầu và màu sắc đã dựng trong JS; phần
   còn lại là cách chúng hoà vào nhau. */
.constellation-star-node .star-spike {
  mix-blend-mode: screen;
  transform-box: fill-box;
  transform-origin: center;
}

/* Nét nối hai lớp: quầng rộng rất mờ nằm dưới, nét mảnh sắc nằm trên —
   giống cách một vệt sáng mảnh trông trong ảnh phơi sáng lâu. */
.constellation-beam-glow {
  opacity: .16;
  filter: blur(2.5px);
  transition: transform 120ms linear, opacity 240ms;
}

.constellation-beam {
  opacity: .72;
}

.constellation-beam:nth-of-type(even) { opacity: .72; }

/* Nhấn vào một cú phản hồi thì cả hai lớp cùng sáng lên. */
.constellation-frame.is-reacting .constellation-beam-glow {
  animation: beamGlowSurge 760ms cubic-bezier(.22, 1, .36, 1) both;
}

@keyframes beamGlowSurge {
  0%   { opacity: .16; }
  38%  { opacity: .42; }
  100% { opacity: .16; }
}

/* Ngôi sáng nhất thở rất chậm và rất nhẹ — biên độ nhỏ tới mức không đọc
   ra là hoạt cảnh, chỉ đọc ra là không khí. Đây là ngoại lệ duy nhất cho
   luật "không lặp vô hạn" ở mục 15, và nó chỉ áp cho đúng một phần tử. */
.constellation-star-node.is-alpha .star-spike {
  animation: alphaBreath 7s ease-in-out infinite;
}

@keyframes alphaBreath {
  0%, 100% { opacity: .55; }
  50%      { opacity: .82; }
}

@media (prefers-reduced-motion: reduce) {
  .constellation-star-node.is-alpha .star-spike { animation: none; }
}

/* ---- 17.4 Rail của Dashboard không dính được -------------------------
   `.dash-rail-sticky` có `position: sticky` nhưng vẫn trôi mất. Nguyên nhân
   không nằm ở nó: phần tử sticky chỉ trượt được trong phạm vi hộp cha, mà
   `<aside class="dash-right-rail">` chỉ cao 870px vì lưới đặt
   `align-items: start` nên cột co lại vừa nội dung — trong khi lưới cao
   3528px. Cho cột giãn hết chiều cao hàng thì sticky mới có đường mà đi. */
.dash-workspace-grid > .dash-right-rail,
.dash-workspace-grid > aside {
  align-self: stretch !important;
}

.dash-right-rail { height: 100%; }

/* ---- 17.5 Net noi phai lui ve sau ------------------------------------
   Trong mot ban do sao that, duong noi giua cac ngoi la thu MO NHAT —
   no chi la chu thich. O ban truoc no lai la thu sang nhat trong hinh,
   nen mat doc ra so do thay vi bau troi. */
.constellation-beam { opacity: .34 !important; stroke-width: .95 !important; }
.constellation-beam-glow { opacity: .07 !important; }
.constellation-frame.is-reacting .constellation-beam { opacity: .62 !important; }

/* =========================================================================
   18. TRẠNG THÁI ĐẦY ĐỦ CHO COMPONENT DÙNG CHUNG

   Phản hồi "components quá tối thiểu" đúng ở chỗ này: phần lớn component
   mới chỉ có trạng thái NGHỈ. Không hover, không focus, không active,
   không vào-ra. Một component chỉ có một trạng thái thì dùng cũng được,
   nhưng nó không nói cho người dùng biết cái gì bấm được, cái gì đang
   được chọn, và thao tác vừa rồi đã nhận hay chưa.
   ========================================================================= */

/* ---- 18.1 Độ sâu trường ảnh khi dừng đọc -----------------------------
   Thanh tiến trình đọc đã bị gỡ. Thay vào đó: khi ngừng cuộn, thẻ nằm ở
   tâm khung nhìn được nâng lên và giữ nguyên độ sắc, phần còn lại lùi ra
   sau. Mức làm mờ cố tình rất nhẹ — đủ để tách lớp, không đủ để người
   dùng phải chờ nó hết mờ mới đọc được thứ bên cạnh.

   Chỉ chạy khi đã dừng cuộn (`body.dof-on`), nên không có chi phí nào
   trong lúc đang cuộn. */
.dof-near, .dof-far {
  transition: filter .34s cubic-bezier(.22,1,.36,1),
              opacity .34s cubic-bezier(.22,1,.36,1),
              transform .34s cubic-bezier(.22,1,.36,1),
              box-shadow .34s cubic-bezier(.22,1,.36,1),
              border-color .34s cubic-bezier(.22,1,.36,1) !important;
}

body.dof-on .dof-far {
  filter: blur(1.1px) saturate(.88) brightness(.86);
  opacity: .62;
  transform: scale(.994);
}

body.dof-on .dof-near {
  transform: translateY(-2px);
  border-color: rgba(190, 222, 255, .34) !important;
  box-shadow:
    0 1px 2px rgba(0,0,0,.30),
    0 26px 56px -26px rgba(0,0,0,.95),
    0 0 34px -18px rgba(126, 200, 245, .55) !important;
}

/* Thẻ đang được đọc không bị lớp nào che, kể cả lớp mực nền. */
body.dof-on .dof-near { position: relative; z-index: 2; }

@media (prefers-reduced-motion: reduce) {
  body.dof-on .dof-far { filter: none; opacity: 1; transform: none; }
  body.dof-on .dof-near { transform: none; }
}

/* ---- 18.2 Về đầu trang ------------------------------------------------ */
.aris-to-top {
  position: fixed;
  right: 24px;
  bottom: 104px;             /* nằm trên nút chat, không đè lên nhau */
  z-index: 1040;
  width: 42px; height: 42px;
  display: grid; place-items: center;
  border-radius: 12px;
  color: #D6E7FF;
  background: linear-gradient(162deg, rgba(34, 48, 74, .92), rgba(26, 37, 56, .92));
  border: 1px solid rgba(190, 222, 255, .26);
  box-shadow: 0 14px 34px -18px rgba(0, 0, 0, .95);
  opacity: 0;
  transform: translateY(10px) scale(.94);
  pointer-events: none;
  transition: opacity .24s cubic-bezier(.22,1,.36,1),
              transform .24s cubic-bezier(.22,1,.36,1),
              border-color .24s, box-shadow .24s;
}

.aris-to-top.is-shown { opacity: 1; transform: none; pointer-events: auto; }
.aris-to-top:hover {
  border-color: rgba(190, 222, 255, .55);
  box-shadow: 0 16px 40px -16px rgba(0,0,0,.95), 0 0 26px -14px rgba(126,200,245,.8);
}
.aris-to-top:active { transform: translateY(1px) scale(.98); }
.aris-to-top svg { width: 19px; height: 19px; }

/* ---- 18.3 Thẻ hiện dần khi lọt vào khung nhìn ------------------------- */
.will-reveal { opacity: 0; transform: translateY(14px); }

.is-revealed {
  opacity: 1;
  transform: none;
  transition: opacity .48s cubic-bezier(.22,1,.36,1),
              transform .48s cubic-bezier(.22,1,.36,1);
}

/* ---- 18.4 Nút xoá trong ô tìm kiếm ----------------------------------- */
.aris-input-clear {
  position: absolute;
  right: 8px; top: 50%;
  transform: translateY(-50%) scale(.8);
  width: 22px; height: 22px;
  display: grid; place-items: center;
  border: 0; border-radius: 50%;
  background: rgba(190, 222, 255, .12);
  color: #CFE0F7;
  opacity: 0; pointer-events: none;
  transition: opacity .18s ease, transform .18s cubic-bezier(.22,1,.36,1), background .18s;
}

.aris-input-clear.is-shown { opacity: 1; transform: translateY(-50%) scale(1); pointer-events: auto; }
.aris-input-clear:hover { background: rgba(190, 222, 255, .26); color: #fff; }
.aris-input-clear svg { width: 12px; height: 12px; }

/* ---- 18.5 Tab: phải thấy được cái nào đang chọn ----------------------- */
.nav-tabs .nav-link, .nav-pills .nav-link, .profile-tabs .nav-link {
  border: 0 !important;
  border-radius: 10px !important;
  color: rgba(186, 202, 224, .78) !important;
  transition: color .18s ease, background .18s ease !important;
  position: relative;
}

.nav-tabs .nav-link:hover, .nav-pills .nav-link:hover, .profile-tabs .nav-link:hover {
  color: #EAF1FB !important;
  background: rgba(146, 186, 255, .06) !important;
}

.nav-tabs .nav-link.active, .nav-pills .nav-link.active, .profile-tabs .nav-link.active {
  color: #FFFFFF !important;
  background: rgba(47, 111, 237, .16) !important;
}

/* Cùng dấu hai-sao-một-nét như chỉ báo ở navbar, để tab và nav nói cùng
   một thứ tiếng. */
.nav-tabs .nav-link.active::after, .profile-tabs .nav-link.active::after {
  content: "";
  position: absolute;
  left: 12px; right: 12px; bottom: -6px;
  height: 4px;
  background:
    radial-gradient(circle at 2px 50%, #d8e9ff 1.6px, transparent 2.1px),
    radial-gradient(circle at calc(100% - 2px) 50%, #d8e9ff 1.6px, transparent 2.1px),
    linear-gradient(to right, transparent 3px, rgba(170,205,255,.40) 3px,
                    rgba(170,205,255,.40) calc(100% - 3px), transparent calc(100% - 3px));
  background-repeat: no-repeat;
  background-size: 100% 4px, 100% 4px, 100% 1px;
  background-position: center;
}

/* ---- 18.6 Dropdown, toast, offcanvas: có đường vào ------------------- */
.dropdown-menu.show {
  animation: popIn .18s cubic-bezier(.22,1,.36,1) both;
  border: 1px solid rgba(190, 222, 255, .22) !important;
  box-shadow: 0 22px 54px -22px rgba(0,0,0,.95) !important;
}

@keyframes popIn {
  from { opacity: 0; transform: translateY(-6px) scale(.985); }
  to   { opacity: 1; transform: none; }
}

.toast {
  background: linear-gradient(162deg, #22304a, #1a2538) !important;
  border: 1px solid rgba(190, 222, 255, .26) !important;
  box-shadow: 0 22px 54px -22px rgba(0,0,0,.95) !important;
  animation: toastIn .28s cubic-bezier(.22,1,.36,1) both;
}

@keyframes toastIn {
  from { opacity: 0; transform: translateX(18px); }
  to   { opacity: 1; transform: none; }
}

/* ---- 18.7 Bảng: đầu bảng dính, hàng phản hồi ------------------------- */
.table thead th {
  position: sticky; top: 68px; z-index: 2;
  background: #141d2d !important;
  border-bottom: 1px solid rgba(190, 222, 255, .18) !important;
  font-family: 'Space Grotesk', Inter, sans-serif !important;
  font-size: 11px !important;
  text-transform: uppercase !important;
  letter-spacing: .12em !important;
  color: rgba(163, 190, 224, .82) !important;
}

/* ---- 18.8 Danh sách, accordion, phân trang --------------------------- */
.list-group-item {
  background: transparent !important;
  border-color: rgba(255, 255, 255, .07) !important;
  color: var(--cosmos-text-body) !important;
  transition: background .18s ease, padding-left .18s ease !important;
}

.list-group-item:hover { background: rgba(146, 186, 255, .05) !important; padding-left: 20px !important; }

.accordion-button {
  background: transparent !important;
  color: #E9EEF6 !important;
  box-shadow: none !important;
  transition: background .18s ease !important;
}

.accordion-button:not(.collapsed) { background: rgba(47, 111, 237, .12) !important; }
.accordion-button::after { filter: invert(1) brightness(1.6); }

.page-link {
  background: rgba(146, 186, 255, .035) !important;
  border-color: rgba(178, 212, 255, .16) !important;
  color: #D3E0F3 !important;
  transition: background .18s ease, border-color .18s ease, transform .18s ease !important;
}

.page-link:hover { background: rgba(146, 186, 255, .10) !important; transform: translateY(-1px) !important; }
.page-item.active .page-link {
  background: rgba(47, 111, 237, .26) !important;
  border-color: rgba(160, 200, 255, .48) !important;
  color: #fff !important;
}

/* ---- 18.9 Trạng thái rỗng: có việc để làm, không chỉ một câu ---------- */
.feed-empty-state, .conversation-empty, .thread-empty, .aris-notif-empty {
  transition: border-color .24s ease !important;
}

/* ---- 18.10 Skeleton khi đang tải ------------------------------------- */
.aris-skeleton {
  background: linear-gradient(90deg,
    rgba(255,255,255,.04) 25%, rgba(255,255,255,.09) 37%, rgba(255,255,255,.04) 63%);
  background-size: 400% 100%;
  animation: skeletonSweep 1.3s ease-in-out infinite;
  border-radius: 8px;
}

@keyframes skeletonSweep {
  0%   { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

@media (prefers-reduced-motion: reduce) {
  .will-reveal { opacity: 1; transform: none; }
  .dropdown-menu.show, .toast { animation: none !important; }
  .aris-skeleton { animation: none !important; }
}

/* ---- 18.1b Thu gọn bài dài, và ghim tiêu điểm ------------------------- */
.post-content-body.is-clamped {
  display: -webkit-box;
  -webkit-line-clamp: 10;
  -webkit-box-orient: vertical;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
  mask-image: linear-gradient(180deg, #000 78%, transparent 100%);
}

.post-clamp-toggle {
  margin-top: 6px;
  padding: 3px 0;
  background: none;
  border: 0;
  color: #A9C5EE;
  font-family: 'Space Grotesk', Inter, sans-serif;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: .01em;
  cursor: pointer;
  transition: color .18s ease;
}

.post-clamp-toggle:hover { color: #E2EBF9; }

/* Bài được ghim (bấm vào hoặc mở bình luận) được nâng cao hơn một bậc so
   với bài chỉ đang nằm ở tâm khung nhìn — hai mức tiêu điểm khác nhau nên
   trông phải khác nhau. */
body.dof-pinned .dof-near {
  transform: translateY(-3px);
  border-color: rgba(190, 222, 255, .48) !important;
  box-shadow:
    0 1px 2px rgba(0,0,0,.30),
    0 30px 64px -26px rgba(0,0,0,.95),
    0 0 42px -16px rgba(126, 200, 245, .75) !important;
}

body.dof-pinned .dof-far {
  filter: blur(1.6px) saturate(.84) brightness(.80);
  opacity: .52;
}

@media (prefers-reduced-motion: reduce) {
  body.dof-pinned .dof-far { filter: none; opacity: 1; }
  body.dof-pinned .dof-near { transform: none; }
}

/* =========================================================================
   19. PHÂN CẤP CHẤT LIỆU — lý do thật khiến giao diện đọc ra "phẳng"

   Đo trên bản đang chạy: thẻ bài viết, thẻ việc làm, thẻ hồ sơ, ô soạn
   bài, panel bộ lọc — TẤT CẢ dùng đúng một công thức bề mặt:
   `linear-gradient(145deg, rgba(16,25,45,.72) …)`, radius 16px, cùng một
   viền. Khi mọi thứ ở cùng một độ cao thì không có gì nổi lên được, và
   thêm bao nhiêu hiệu ứng cũng không cứu được — mắt đọc chiều sâu bằng
   SỰ KHÁC BIỆT giữa các mặt phẳng, không bằng số lượng hiệu ứng.

   Ba bậc, mỗi bậc một chất liệu khác nhau:
     · Bậc 1 — panel nền: phẳng, chìm, không gradient. Nó là cái khay.
     · Bậc 2 — thẻ nội dung: có gradient, có vạch sáng mép trên, bóng sâu.
     · Bậc 3 — bề mặt chủ đạo: như bậc 2 nhưng sáng hơn và có dấu chòm sao.
   ========================================================================= */

/* ---- 19.1 Một nguồn sáng duy nhất, từ trên xuống ----------------------
   Giao diện tối chỉ "có khối" khi có một nguồn sáng nhất quán. Trước đây
   không có nguồn nào, nên mọi mặt phẳng sáng đều nhau. */
main::after { content: none; }   /* tên chòm sao cũ, thay bằng quầng sáng dưới */

body::before {
  content: "";
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 420px;
  z-index: 0;
  pointer-events: none;
  background: radial-gradient(ellipse 70% 100% at 50% -10%,
              rgba(88, 132, 208, .13) 0%, rgba(50, 82, 150, .05) 42%, transparent 72%);
}

/* ---- 19.2 Bậc 1 — panel nền: chìm xuống ------------------------------- */
.filter-sidebar-card,
.dash-rail-sticky > .card,
.aris-rail-card,
.profile-rail-card {
  background: rgba(255, 255, 255, .022) !important;
  background-image: none !important;
  border: 1px solid rgba(255, 255, 255, .055) !important;
  box-shadow: none !important;
  border-radius: 12px !important;
}

/* ---- 19.3 Bậc 2 — thẻ nội dung: nâng lên -----------------------------
   Vạch sáng mép trên là dấu hiệu kinh điển của một mặt phẳng được nâng:
   nó là cạnh bắt sáng từ nguồn sáng ở trên. Không có nó, card chỉ là một
   hình chữ nhật tối hơn nền. */
.post-card, .card, .card-aris, .aris-card, .company-card-item {
  position: relative;
  background: linear-gradient(168deg, #1b2740 0%, #141d2f 62%, #111a2a 100%) !important;
  border: 1px solid rgba(255, 255, 255, .075) !important;
  border-radius: 14px !important;
  box-shadow:
    0 1px 1px rgba(0, 0, 0, .40),
    0 16px 34px -24px rgba(0, 0, 0, .90) !important;
}

.post-card::after, .card::after, .card-aris::after,
.aris-card::after, .company-card-item::after {
  content: "";
  position: absolute;
  inset: 0 0 auto 0;
  height: 1px;
  border-radius: 14px 14px 0 0;
  background: linear-gradient(90deg,
    transparent 4%, rgba(198, 224, 255, .34) 34%,
    rgba(198, 224, 255, .34) 66%, transparent 96%);
  pointer-events: none;
}

/* ---- 19.4 Bậc 3 — bề mặt chủ đạo -------------------------------------
   Ô soạn bài là chỗ người dùng được mời hành động, nên nó phải là mặt
   sáng nhất trên trang, và mang dấu nhận diện. */
.feed-composer-card {
  background:
    radial-gradient(ellipse 60% 120% at 88% -20%, rgba(90, 140, 225, .16), transparent 60%),
    linear-gradient(168deg, #22304c 0%, #18233a 70%, #141d2f 100%) !important;
  border: 1px solid rgba(190, 222, 255, .16) !important;
  border-radius: 16px !important;
  box-shadow:
    0 1px 1px rgba(0, 0, 0, .40),
    0 22px 44px -28px rgba(0, 0, 0, .95) !important;
}

.feed-composer-card::after {
  background: linear-gradient(90deg,
    transparent 3%, rgba(214, 235, 255, .55) 30%,
    rgba(214, 235, 255, .55) 70%, transparent 97%) !important;
  border-radius: 16px 16px 0 0 !important;
}

/* ---- 19.5 Navbar cũng phải là một mặt phẳng có cạnh ------------------- */
.navbar {
  background: linear-gradient(180deg, #131c2c 0%, #0e1521 100%) !important;
  border-bottom: 1px solid rgba(255, 255, 255, .06) !important;
  box-shadow: 0 1px 0 rgba(198, 224, 255, .05) inset,
              0 10px 30px -18px rgba(0, 0, 0, .9) !important;
}

/* ---- 19.6 Icon navbar mới: nét mảnh, sáng lên khi được chọn ----------- */
.navbar .nav-link svg[data-aris-icon] {
  width: 20px !important;
  height: 20px !important;
  stroke-width: 1.45 !important;
  transition: transform .22s cubic-bezier(.22,1,.36,1), filter .22s ease !important;
}

.navbar .nav-link:hover svg[data-aris-icon] { transform: translateY(-1px); }

.navbar .nav-item.active .nav-link svg[data-aris-icon] {
  filter: drop-shadow(0 0 7px rgba(126, 200, 245, .55));
}

/* ---- 19.7 Tiêu đề mục: một vạch có nút sao --------------------------- */
.feed-heading, .composer-heading, .filter-group-title,
.cosmos-page-eyebrow, .auth-demo-tray-label {
  position: relative;
  padding-left: 16px !important;
}

.feed-heading::before, .composer-heading::before, .filter-group-title::before,
.cosmos-page-eyebrow::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  width: 9px; height: 1px;
  background: linear-gradient(90deg, rgba(170, 205, 255, .18), rgba(170, 205, 255, .55));
  transform: translateY(-50%);
}

.feed-heading::after, .composer-heading::after, .filter-group-title::after,
.cosmos-page-eyebrow::after {
  content: "";
  position: absolute;
  left: 9px; top: 50%;
  width: 3px; height: 3px;
  border-radius: 50%;
  background: #cfe4ff;
  box-shadow: 0 0 6px rgba(126, 200, 245, .8);
  transform: translateY(-50%);
}

/* ---- 19.8 Ảnh đại diện: vòng có khấc ---------------------------------- */
#navAvatar, .avatar-main, .post-card img.rounded-circle {
  box-shadow:
    0 0 0 1px rgba(190, 222, 255, .22),
    0 0 0 3px rgba(12, 20, 34, .9),
    0 0 0 4px rgba(190, 222, 255, .10) !important;
}

/* =========================================================================
   20. ICON NAVBAR TỰ VẼ, HOVER RÃ THÀNH CHÒM SAO

   Hai lý do làm bằng CSS chứ không bằng JS:
   · Bản JS đã thử bị một đoạn script khác dựng lại nội dung <svg> đè lên —
     thuộc tính `data-aris-icon` còn nguyên nhưng các <path> quay về Lucide.
     CSS thì không script nào ghi đè được.
   · Cần hai lớp hình chồng nhau để chuyển cảnh, mà pseudo-element cho sẵn
     đúng hai lớp: ::before là hình thường, ::after là chòm sao.

   Khi rê chuột, hình thường thu nhỏ và mờ đi, chòm sao nở ra và hiện lên —
   cùng một vật thể nhìn từ hai khoảng cách, không phải hai icon khác nhau.
   ========================================================================= */

/* Giấu icon Lucide gốc, nhưng vẫn để nó trong DOM vì selector :has() dựa
   vào class của nó để biết đây là mục nào. */
.navbar .nav-link > svg.lucide { opacity: 0 !important; }

.navbar .nav-link { position: relative; }

.navbar .nav-link::before,
.navbar .nav-link::after {
  content: "";
  position: absolute;
  top: 8px;
  left: 50%;
  width: 22px;
  height: 22px;
  margin-left: -11px;
  background-repeat: no-repeat !important;
  background-position: center !important;
  background-size: 22px 22px !important;
  background-color: transparent !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  pointer-events: none;
  transition: opacity .26s cubic-bezier(.22,1,.36,1),
              transform .34s cubic-bezier(.22,1,.36,1),
              filter .26s ease;
}

/* Hình thường */
.navbar .nav-link::before { opacity: 1; transform: scale(1); }
/* Chòm sao, chờ sẵn ở trạng thái thu nhỏ */
.navbar .nav-link::after  { opacity: 0; transform: scale(.72) rotate(-8deg); }

.navbar .nav-link:hover::before,
.navbar .nav-link:focus-visible::before { opacity: 0; transform: scale(1.22); }

.navbar .nav-link:hover::after,
.navbar .nav-link:focus-visible::after {
  opacity: 1;
  transform: scale(1) rotate(0deg);
  filter: drop-shadow(0 0 6px rgba(126, 200, 245, .7));
}

/* Mục đang chọn giữ luôn dạng chòm sao — nó đang là "nơi bạn ở". */
.navbar .nav-item.active .nav-link::before { opacity: 0; transform: scale(1.18); }
.navbar .nav-item.active .nav-link::after {
  opacity: 1;
  transform: none;
  filter: drop-shadow(0 0 7px rgba(126, 200, 245, .6));
}

@media (prefers-reduced-motion: reduce) {
  .navbar .nav-link::before, .navbar .nav-link::after { transition: opacity .01s; }
}

.navbar .nav-link:has(svg.lucide-home)::before { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23A9BCD8' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='5'/><ellipse cx='12' cy='12' rx='9.6' ry='3.3' transform='rotate(-22 12 12)' opacity='.7'/></svg>") !important; }
.navbar .nav-link:has(svg.lucide-home)::after  { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23CFE4FF' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M5 15.5 9.5 8.5 14.5 13 19 6.5' opacity='.55'/><circle cx='5' cy='15.5' r='1.5' fill='%23DCEBFF' stroke='none'/><circle cx='9.5' cy='8.5' r='2.1' fill='%23FFFFFF' stroke='none'/><circle cx='14.5' cy='13' r='1.4' fill='%23DCEBFF' stroke='none'/><circle cx='19' cy='6.5' r='1.6' fill='%23DCEBFF' stroke='none'/></svg>") !important; }

.navbar .nav-link:has(svg.lucide-users)::before { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23A9BCD8' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M7.6 15.4 16.4 8.2' opacity='.6'/><circle cx='6.6' cy='16.4' r='2.8'/><circle cx='17.4' cy='7.2' r='2.3'/></svg>") !important; }
.navbar .nav-link:has(svg.lucide-users)::after  { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23CFE4FF' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M5.5 17.5 11 12.5 18.5 6' opacity='.55'/><path d='M11 12.5 16 17' opacity='.4'/><circle cx='5.5' cy='17.5' r='1.5' fill='%23DCEBFF' stroke='none'/><circle cx='11' cy='12.5' r='2.1' fill='%23FFFFFF' stroke='none'/><circle cx='18.5' cy='6' r='1.6' fill='%23DCEBFF' stroke='none'/><circle cx='16' cy='17' r='1.2' fill='%23DCEBFF' stroke='none'/></svg>") !important; }

.navbar .nav-link:has(svg.lucide-briefcase)::before { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23A9BCD8' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M3.4 17.2C7.4 16 13.4 12.2 19.4 5.6'/><path d='M15.6 5.2h4.2v4.2' opacity='.75'/><circle cx='3.8' cy='17.4' r='1.4'/></svg>") !important; }
.navbar .nav-link:has(svg.lucide-briefcase)::after  { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23CFE4FF' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M4 18 9 14.5 13.5 16 19.5 5.5' opacity='.55'/><circle cx='4' cy='18' r='1.4' fill='%23DCEBFF' stroke='none'/><circle cx='9' cy='14.5' r='1.6' fill='%23DCEBFF' stroke='none'/><circle cx='13.5' cy='16' r='1.2' fill='%23DCEBFF' stroke='none'/><circle cx='19.5' cy='5.5' r='2.2' fill='%23FFFFFF' stroke='none'/></svg>") !important; }

.navbar .nav-link:has(svg.lucide-building)::before { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23A9BCD8' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M12 4.6 7.6 12.2h8.8L12 4.6Z'/><path d='M5.4 19.2h13.2' opacity='.75'/><path d='M9.4 15.6v3.6M14.6 15.6v3.6M12 14.4v4.8' opacity='.5'/></svg>") !important; }
.navbar .nav-link:has(svg.lucide-building)::after  { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23CFE4FF' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M12 5 7 13.8 17 13.8Z' opacity='.5'/><path d='M7 13.8 12 18.8 17 13.8' opacity='.4'/><circle cx='12' cy='5' r='2.1' fill='%23FFFFFF' stroke='none'/><circle cx='7' cy='13.8' r='1.5' fill='%23DCEBFF' stroke='none'/><circle cx='17' cy='13.8' r='1.5' fill='%23DCEBFF' stroke='none'/><circle cx='12' cy='18.8' r='1.3' fill='%23DCEBFF' stroke='none'/></svg>") !important; }

.navbar .nav-link:has(svg.lucide-bell)::before { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23A9BCD8' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M6.6 16.2c1-1 1.3-2.1 1.3-3.5v-2a4.1 4.1 0 0 1 8.2 0v2c0 1.4.3 2.5 1.3 3.5Z'/><path d='M10.3 19.1a2 2 0 0 0 3.4 0'/></svg>") !important; }
.navbar .nav-link:has(svg.lucide-bell)::after  { background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23CFE4FF' stroke-width='1.45' stroke-linecap='round' stroke-linejoin='round'><path d='M12 5.5 12 18.5M7 9 17 9M8.5 14 15.5 14' opacity='.45'/><circle cx='12' cy='5.5' r='1.5' fill='%23DCEBFF' stroke='none'/><circle cx='7' cy='9' r='1.3' fill='%23DCEBFF' stroke='none'/><circle cx='17' cy='9' r='1.3' fill='%23DCEBFF' stroke='none'/><circle cx='12' cy='11.8' r='2.1' fill='%23FFFFFF' stroke='none'/><circle cx='8.5' cy='14' r='1.1' fill='%23DCEBFF' stroke='none'/><circle cx='15.5' cy='14' r='1.1' fill='%23DCEBFF' stroke='none'/><circle cx='12' cy='18.5' r='1.3' fill='%23DCEBFF' stroke='none'/></svg>") !important; }

/* =========================================================================
   21. HẾT "KHỐI TRONG KHỐI"

   Lỗi bố cục nặng nhất hiện tại: một thẻ có nền và viền, bên trong lại là
   một ô có nền và viền, bên trong nữa là các chip cũng có nền và viền. Ba
   lớp hộp lồng nhau cho một mẩu thông tin — mắt phải vượt qua ba cái khung
   mới tới được nội dung, và trang đọc ra như một cái bảng ghép.

   Luật: MỘT bề mặt cho MỘT bậc. Cấu trúc bên trong nói bằng khoảng cách,
   kiểu chữ và nét kẻ mảnh — không bằng thêm một cái hộp nữa.
   ========================================================================= */

/* ---- 21.1 Ô nhập nằm trong thẻ: bỏ hộp, giữ một đường chân ------------ */
.feed-composer-card .composer-textarea,
.feed-composer-card input[type=text],
.post-card input[type=text],
.card .composer-textarea {
  background: transparent !important;
  border: 0 !important;
  border-bottom: 1px solid rgba(255, 255, 255, .09) !important;
  border-radius: 0 !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
  box-shadow: none !important;
  transition: border-color .2s ease !important;
}

.feed-composer-card .composer-textarea:focus,
.card .composer-textarea:focus {
  border-bottom-color: rgba(126, 200, 245, .8) !important;
  box-shadow: none !important;
}

/* ---- 21.2 Chip meta trong thẻ việc làm: bỏ viên, còn chữ và dấu ngăn -- */
.card .badge[class*="bg-secondary-subtle"],
.card .badge[class*="bg-light"],
.job-meta-chip {
  background: transparent !important;
  border: 0 !important;
  padding: 0 !important;
  color: rgba(176, 194, 220, .82) !important;
  opacity: 1 !important;
  position: relative;
  margin-right: 18px !important;
}

/* Dấu ngăn là một chấm sao nhỏ giữa hai mẩu, thay cho viền của từng viên. */
.card .badge[class*="bg-secondary-subtle"]:not(:last-child)::after,
.card .badge[class*="bg-light"]:not(:last-child)::after {
  content: "";
  position: absolute;
  right: -10px; top: 50%;
  width: 2.5px; height: 2.5px;
  border-radius: 50%;
  background: rgba(170, 205, 255, .45);
  transform: translateY(-50%);
}

/* Mức lương vẫn giữ viên, vì nó là thứ DUY NHẤT cần nổi trong hàng meta. */
.card .badge[class*="bg-success-subtle"] {
  background: rgba(143, 205, 178, .13) !important;
  border: 1px solid rgba(143, 205, 178, .28) !important;
  padding: 5px 11px !important;
}

/* ---- 21.3 Hàng trong rail: bỏ hộp con, dùng nét kẻ ------------------- */
.dash-rail-sticky .card .card,
.aris-rail-card .card,
.filter-sidebar-card .card,
.card .card {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.card .card::after { display: none !important; }   /* không vạch sáng cho hộp con */

.card .card + .card {
  border-top: 1px solid rgba(255, 255, 255, .06) !important;
}

/* ---- 21.4 Ô tìm kiếm trên navbar: một đường, không phải một hộp ------- */
.navbar .SearchContainer {
  background: rgba(255, 255, 255, .03) !important;
  border: 0 !important;
  border-bottom: 1px solid rgba(255, 255, 255, .10) !important;
  border-radius: 8px 8px 0 0 !important;
}

.navbar .SearchContainer:focus-within {
  border-bottom-color: rgba(126, 200, 245, .8) !important;
  background: rgba(255, 255, 255, .05) !important;
}

/* ---- 21.5 Nhóm bộ lọc: bỏ khung từng nhóm ---------------------------- */
.filter-sidebar-card .form-select,
.filter-sidebar-card .form-control {
  background: rgba(0, 0, 0, .22) !important;
  border: 1px solid rgba(255, 255, 255, .07) !important;
}

/* Mục đang chọn: icon giữ dạng chòm sao, và gạch chỉ báo nằm ở phần tử cha
   nên không còn tranh chỗ với icon. */
.navbar .nav-item.active .nav-link::after {
  opacity: 1 !important;
  transform: none !important;
  filter: drop-shadow(0 0 7px rgba(126, 200, 245, .6)) !important;
  background-color: transparent !important;
  box-shadow: none !important;
  border-radius: 0 !important;
  background-repeat: no-repeat !important;
  background-position: center !important;
  background-size: 22px 22px !important;
  height: 22px !important;
  width: 22px !important;
  top: 8px !important;
  left: 50% !important;
  bottom: auto !important;
  margin-left: -11px !important;
}

/* Gạch chỉ báo neo vào .nav-item, nên chính nó phải là gốc toạ độ — thiếu
   dòng này thì nó neo vào tổ tiên xa và kéo dài hết chiều ngang trang. */
.navbar .nav-item { position: relative !important; }

/* =========================================================================
   22. BỎ KIỂU CHỒNG HỘP BO TRÒN, VÀ KINH TUYẾN LỀ TRÁI

   Hai phản hồi, cùng một gốc: bố cục đang là "xếp các hộp bo tròn cạnh
   nhau". Bốn ô lối tắt ở dải trên là bốn hộp `radius 16px`; rail phải là
   một chồng hộp nữa. Bo tròn nhiều ở kích thước lớn làm mọi khối mềm nhũn
   và giống nhau, và mỗi hộp lại vẽ thêm một cái khung mà mắt phải vượt qua.

   Cách khác: **gộp thành một khối liền, chia bằng nét kẻ**. Một strip có
   bốn ngăn thì đọc ra là một thứ có cấu trúc; bốn hộp rời thì đọc ra là
   bốn thứ chưa xếp xong.
   ========================================================================= */

/* ---- 22.1 Dải lối tắt: một strip bốn ngăn, không phải bốn hộp --------- */
.dash-telemetry-strip {
  display: grid !important;
  grid-template-columns: repeat(4, 1fr) !important;
  gap: 0 !important;
  border: 1px solid rgba(255, 255, 255, .075) !important;
  border-radius: 10px !important;
  overflow: hidden !important;
  background: linear-gradient(180deg, rgba(255, 255, 255, .022), rgba(255, 255, 255, .008)) !important;
  box-shadow: 0 1px 1px rgba(0,0,0,.35), 0 14px 30px -26px rgba(0,0,0,.9) !important;
}

.dash-telemetry-strip > .telemetry-pill,
.dash-telemetry-strip > a.telemetry-pill {
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  margin: 0 !important;
  transition: background .2s ease !important;
}

.dash-telemetry-strip > .telemetry-pill + .telemetry-pill {
  border-left: 1px solid rgba(255, 255, 255, .07) !important;
}

.dash-telemetry-strip > a.telemetry-pill:hover {
  background: rgba(146, 186, 255, .055) !important;
  transform: none !important;     /* cả strip là một khối, không ô nào nhảy lên */
}

/* Ngăn đầu tiên vẫn là việc nên làm trước, nhưng đánh dấu bằng một vạch
   sáng ở mép trên chứ không bằng một cái hộp riêng. */
.dash-telemetry-strip > a.telemetry-pill:first-child {
  background: linear-gradient(180deg, rgba(47, 111, 237, .13), transparent 70%) !important;
  box-shadow: inset 0 1px 0 rgba(190, 222, 255, .45) !important;
}

/* ---- 22.2 Rail phải: một cột liền, chia bằng nét kẻ ------------------
   Trước: profile là một hộp bo 12px có gradient, rồi ba khối nữa xếp dưới.
   Giờ: cả cột treo trên MỘT đường dọc — đúng nghĩa một "rail" — và các
   mục ngăn nhau bằng nét ngang. Không còn cái khung nào. */
.dash-rail-sticky {
  border-left: 1px solid rgba(255, 255, 255, .07);
  padding-left: 22px;
}

.dash-rail-sticky > * {
  background: none !important;
  background-image: none !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.dash-rail-sticky > *::after { display: none !important; }   /* không vạch sáng cho hộp con */

.dash-rail-sticky > * + * {
  border-top: 1px solid rgba(255, 255, 255, .06) !important;
  margin-top: 18px !important;
  padding-top: 18px !important;
}

/* Mỗi mục có một nút sao trên đường dọc — chỗ nó gắn vào cột. */
.dash-rail-sticky > * {
  position: relative;
}

.dash-rail-sticky > *::before {
  content: "";
  position: absolute;
  left: -26px;
  top: 6px;
  width: 7px; height: 7px;
  border-radius: 50%;
  background: rgba(190, 222, 255, .30);
  box-shadow: 0 0 0 3px rgba(12, 20, 34, .95);
}

.dash-rail-sticky > *:first-child::before {
  background: #CFE4FF;
  box-shadow: 0 0 0 3px rgba(12, 20, 34, .95), 0 0 9px rgba(126, 200, 245, .8);
}

/* Cùng cách xử lý cho rail của Jobs và bộ lọc, để ba trang nói một thứ tiếng. */
.filter-sidebar-card {
  background: none !important;
  border: 0 !important;
  border-left: 1px solid rgba(255, 255, 255, .07) !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding-left: 22px !important;
}

.filter-sidebar-card::after { display: none !important; }

/* ---- 22.3 Kỷ luật bo góc --------------------------------------------
   16px trên một khối cao 60px là quá tròn — khối mất cạnh, và mọi thứ
   trông như viên thuốc. Chip nhỏ thì vẫn để pill vì ở cỡ đó pill mới đúng. */
.card, .card-aris, .aris-card, .post-card, .company-card-item { border-radius: 10px !important; }
.card::after, .card-aris::after, .aris-card::after,
.post-card::after, .company-card-item::after { border-radius: 10px 10px 0 0 !important; }
.feed-composer-card { border-radius: 12px !important; }
.feed-composer-card::after { border-radius: 12px 12px 0 0 !important; }
.btn { border-radius: 9px !important; }
.form-control, .form-select, .search-input { border-radius: 9px !important; }
.modal-content { border-radius: 12px !important; }

/* ---- 22.4 Kinh tuyến lề trái ----------------------------------------
   Lề trái rộng 120px và hoàn toàn trống, trong khi lề phải có chòm sao —
   trang lệch hẳn về một bên. Thêm một đường kinh tuyến có nút sao: đủ để
   lề trái có việc để làm, đủ mảnh để không tranh chấp với nội dung.

   Dùng lại `main::before` — nó đang giữ một hình cũ ở `opacity: 0`, tức
   là gánh nặng chết. */
main::before {
  content: "" !important;
  position: fixed !important;
  left: 52px !important;
  top: 150px !important;
  bottom: 90px !important;
  width: 18px !important;
  height: auto !important;
  z-index: 0 !important;
  opacity: 1 !important;
  pointer-events: none !important;
  animation: none !important;
  transform: none !important;
  background-image:
    linear-gradient(180deg, transparent 0%, rgba(170, 205, 255, .16) 10%,
                    rgba(170, 205, 255, .16) 90%, transparent 100%),
    radial-gradient(circle at 9px 14%, #CFE4FF 1.7px, transparent 2.4px),
    radial-gradient(circle at 9px 38%, rgba(207, 228, 255, .55) 1.2px, transparent 1.8px),
    radial-gradient(circle at 9px 62%, #CFE4FF 2.1px, transparent 2.9px),
    radial-gradient(circle at 9px 86%, rgba(207, 228, 255, .55) 1.3px, transparent 1.9px) !important;
  background-size: 1px 100%, 100% 100%, 100% 100%, 100% 100%, 100% 100% !important;
  background-position: 9px 0, 0 0, 0 0, 0 0, 0 0 !important;
  background-repeat: no-repeat !important;
  filter: drop-shadow(0 0 6px rgba(126, 200, 245, .28));
}

/* Dưới 1400px thì lề trái không còn đủ rộng, bỏ đi thay vì để nó chen vào. */
@media (max-width: 1399px) {
  main::before { display: none !important; }
}

/* aris-dashboard.css nạp SAU aris-cosmos.css, nên `!important` của nó thắng
   ở cùng độ đặc hiệu. Nhắm thẳng từng class con để vượt lên — đây là cách
   đúng, không phải nhồi thêm !important. */
.dash-rail-sticky > .profile-rail-card,
.dash-rail-sticky > .jobs-rail-card,
.dash-rail-sticky > .workspace-links,
.dash-rail-sticky > .aris-rail-card,
.dash-rail-sticky > .card {
  background: none !important;
  background-image: none !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

.dash-rail-sticky > .profile-rail-card + *,
.dash-rail-sticky > .jobs-rail-card + *,
.dash-rail-sticky > .workspace-links + *,
.dash-rail-sticky > .card + * {
  border-top: 1px solid rgba(255, 255, 255, .06) !important;
}

/* Dải header gradient bên trong thẻ hồ sơ cũng là một cái hộp nữa. */
.dash-rail-sticky .profile-rail-cover,
.dash-rail-sticky .cosmos-profile-hero,
.dash-rail-sticky .rail-profile-header {
  background: none !important;
  border: 0 !important;
  height: auto !important;
  min-height: 0 !important;
}

/* Kinh tuyến lề trái: đậm hơn một chút, 16% là quá mảnh để nhận ra. */
main::before {
  background-image:
    linear-gradient(180deg, transparent 0%, rgba(178, 212, 255, .28) 10%,
                    rgba(178, 212, 255, .28) 90%, transparent 100%),
    radial-gradient(circle at 9px 14%, #DCEBFF 2px, transparent 2.8px),
    radial-gradient(circle at 9px 38%, rgba(207, 228, 255, .7) 1.4px, transparent 2.1px),
    radial-gradient(circle at 9px 62%, #DCEBFF 2.4px, transparent 3.3px),
    radial-gradient(circle at 9px 86%, rgba(207, 228, 255, .7) 1.5px, transparent 2.2px) !important;
  filter: drop-shadow(0 0 7px rgba(126, 200, 245, .45)) !important;
}

/* Avatar trong rail có lề âm để đè lên dải cover; bỏ cover rồi thì lề âm đó
   kéo nó lên khỏi khung và bị cắt mất nửa trên. */
.dash-rail-sticky > .profile-rail-card { padding-top: 4px !important; }

.dash-rail-sticky .profile-rail-card img,
.dash-rail-sticky .profile-rail-card .rounded-circle,
.dash-rail-sticky .profile-rail-card [class*="avatar"] {
  margin-top: 0 !important;
  top: auto !important;
  transform: none !important;
}

/* Kinh tuyến: .28 vẫn quá mảnh để nhận ra là một chi tiết có chủ ý. Đậm hơn,
   nút sao to hơn, và thêm vạch chia ngang — nó đọc ra là một trục toạ độ
   thiên văn chứ không phải một vệt bẩn trên màn hình. */
main::before {
  width: 26px !important;
  left: 46px !important;
  background-image:
    linear-gradient(180deg, transparent 0%, rgba(178, 212, 255, .42) 8%,
                    rgba(178, 212, 255, .42) 92%, transparent 100%),
    linear-gradient(90deg, rgba(178, 212, 255, .34) 0 9px, transparent 9px),
    linear-gradient(90deg, rgba(178, 212, 255, .34) 0 9px, transparent 9px),
    linear-gradient(90deg, rgba(178, 212, 255, .22) 0 5px, transparent 5px),
    linear-gradient(90deg, rgba(178, 212, 255, .22) 0 5px, transparent 5px),
    radial-gradient(circle at 9px 14%, #E6F1FF 2.4px, transparent 3.3px),
    radial-gradient(circle at 9px 38%, rgba(214, 235, 255, .8) 1.7px, transparent 2.4px),
    radial-gradient(circle at 9px 62%, #E6F1FF 2.9px, transparent 4px),
    radial-gradient(circle at 9px 86%, rgba(214, 235, 255, .8) 1.8px, transparent 2.5px) !important;
  background-size:
    1px 100%,
    17px 1px, 17px 1px, 13px 1px, 13px 1px,
    100% 100%, 100% 100%, 100% 100%, 100% 100% !important;
  background-position:
    9px 0,
    9px 14%, 9px 62%, 9px 38%, 9px 86%,
    0 0, 0 0, 0 0, 0 0 !important;
  background-repeat: no-repeat !important;
  filter: drop-shadow(0 0 8px rgba(126, 200, 245, .5)) !important;
}

/* Kinh tuyến bị ẩn bởi rule `body:has(#arisCosmicConstellationStage)
   main::before { display:none !important }` — rule đó được thêm để giấu
   hình zodiac cũ mà `main::before` từng giữ. Nay pseudo-element này mang
   nội dung khác, nên mở lại bằng cùng độ đặc hiệu, đặt sau. */
body:has(#arisCosmicConstellationStage) main::before,
body main::before {
  display: block !important;
}

@media (max-width: 1399px) {
  body:has(#arisCosmicConstellationStage) main::before,
  body main::before { display: none !important; }
}

/* Avatar rail bị cắt: `.profile-rail-body` có `margin-top: -26px` để đè lên
   dải cover, mà `.profile-rail-card` thì `overflow: hidden`. Bỏ cover rồi
   nên lề âm đó chỉ còn tác dụng cắt mất nửa trên ảnh. */
.dash-rail-sticky .profile-rail-card { overflow: visible !important; }
.dash-rail-sticky .profile-rail-body { margin-top: 0 !important; }

/* =========================================================================
   23. TRẢ LẠI SỰ SỐNG CHO TRƯỜNG SAO

   Canvas trường sao VẪN đang chạy — đo bằng cách lấy mẫu pixel cách nhau
   900ms, giá trị khác nhau. Nhưng tôi đã hạ nó xuống `opacity: .34` rồi
   phủ thêm một lớp mực toàn màn hình để chữ khỏi nằm trên nhiễu. Kết quả:
   thứ duy nhất chuyển động liên tục trên trang thì gần như không nhìn thấy,
   và cảm giác "gần như không có animation" là đúng.

   Sửa bằng MẶT NẠ thay vì hạ độ sáng: trường sao sống mạnh ở hai bên lề —
   nơi vốn trống — và tắt hẳn phía sau cột nội dung. Không phải đánh đổi
   giữa "đẹp" và "đọc được" nữa, vì hai thứ đó không còn nằm chồng nhau.
   ========================================================================= */

.aris-cosmos-canvas {
  opacity: .92 !important;
  -webkit-mask-image:
    linear-gradient(90deg,
      #000 0%, #000 7%,
      rgba(0,0,0,.55) 13%,
      transparent 23%, transparent 77%,
      rgba(0,0,0,.55) 87%,
      #000 93%, #000 100%);
  mask-image:
    linear-gradient(90deg,
      #000 0%, #000 7%,
      rgba(0,0,0,.55) 13%,
      transparent 23%, transparent 77%,
      rgba(0,0,0,.55) 87%,
      #000 93%, #000 100%);
  transition: opacity .4s ease;
}

/* Lớp mực toàn màn hình không còn cần gánh việc che sao nữa — hạ xuống mức
   chỉ còn làm nền tối dịu ở rìa. */
body::after {
  background:
    radial-gradient(ellipse 66% 74% at 50% 42%, rgba(9, 13, 22, .55) 0%,
                    rgba(9, 13, 22, .22) 58%, transparent 100%) !important;
}

/* Màn hẹp thì không còn lề để trường sao sống, nên trả về nền tĩnh dịu. */
@media (max-width: 1199px) {
  .aris-cosmos-canvas {
    opacity: .34 !important;
    -webkit-mask-image: none;
    mask-image: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .aris-cosmos-canvas { opacity: .28 !important; }
}

/* ---- 23.1 Nút bỏ khối gợi ý cho tài khoản mới ------------------------
   Khối "Gợi ý việc làm từ Aris AI" ở đầu trang Jobs là lời mời dành cho
   tài khoản chưa có CV. Nó đúng cho người mới, nhưng đang không có cách
   nào để tắt đi sau khi đã đọc. */
#ai-recommendation-section { position: relative; }

.aris-dismiss {
  position: absolute;
  top: 10px; right: 10px;
  width: 26px; height: 26px;
  display: grid; place-items: center;
  border: 1px solid rgba(178, 212, 255, .16);
  border-radius: 8px;
  background: rgba(146, 186, 255, .05);
  color: rgba(198, 214, 238, .78);
  cursor: pointer;
  transition: background .18s ease, border-color .18s ease, color .18s ease;
}

.aris-dismiss:hover {
  background: rgba(146, 186, 255, .12);
  border-color: rgba(190, 222, 255, .38);
  color: #fff;
}

.aris-dismiss svg { width: 13px; height: 13px; }

/* =========================================================================
   24. TÍN HIỆU RUNE
   Lúc một dòng đang nhiễu thành chữ rune, nó sáng lên và hơi loãng ra —
   đủ để người đọc hiểu đây là hiệu ứng có chủ ý chứ không phải chữ lỗi
   font. Hết nhiễu thì trả về nguyên trạng trong 240ms.
   ========================================================================= */
.is-transmitting {
  color: #DCEBFF !important;
  text-shadow: 0 0 12px rgba(126, 200, 245, .55), 0 0 26px rgba(47, 111, 237, .3);
  letter-spacing: .012em;
  transition: color .1s linear, text-shadow .1s linear, letter-spacing .1s linear;
}

.is-transmitting .cosmos-gradient-text {
  color: #DCEBFF !important;
  -webkit-text-fill-color: #DCEBFF !important;
}

/* Hiệu ứng giờ chạy ở bất kỳ phần tử nào có chữ, nên không thể liệt kê
   selector để gắn transition tắt dần. Dùng `[data-rune-last]` — thuộc tính
   JS đặt lên phần tử ngay sau lần phát đầu tiên — nên chỉ đúng những phần
   tử đã từng nhiễu mới mang transition, không rải lên cả trang. */
[data-rune-last] {
  transition: color .24s ease, text-shadow .24s ease, letter-spacing .24s ease;
}

@media (prefers-reduced-motion: reduce) {
  .is-transmitting { text-shadow: none; }
}


/* =========================================================================
   CELESTAIL PASS — milky haze + denser gutters + deeper void
   ========================================================================= */
body.aris-app-shell,
body {
  background-color: #01030a !important;
}

/* Soft galactic dust lane behind canvas (CSS underpainting) */
body.aris-app-shell::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    linear-gradient(118deg,
      transparent 12%,
      rgba(40, 50, 90, 0.10) 38%,
      rgba(90, 85, 130, 0.07) 48%,
      rgba(120, 100, 140, 0.045) 56%,
      transparent 82%),
    radial-gradient(ellipse 42% 28% at 46% 54%, rgba(160, 175, 220, 0.05) 0%, transparent 70%);
  mix-blend-mode: screen;
  opacity: 0.85;
}

.cosmos-page-head {
  padding-bottom: 10px !important;
  margin-bottom: 12px !important;
}

@media (min-width: 1200px) {
  .container, .container-lg, .container-xl, .container-xxl,
  .aris-container, .dashboard-page, .cosmos-page-container, .jobs-page {
    padding-left: 15px !important;
    padding-right: 15px !important;
  }
  .dashboard-page {
    padding-top: 18px !important;
    padding-bottom: 32px !important;
  }
}

@media (min-width: 992px) {
  .cosmos-page-head,
  .dashboard-heading {
    padding-right: 240px !important; /* free more sky beside titles */
  }
}

/* Let cosmos read more in side gutters; keep center readable */
@media (min-width: 1200px) {
  .aris-cosmos-canvas {
    opacity: .95 !important;
    -webkit-mask-image:
      linear-gradient(90deg,
        #000 0%, #000 10%,
        rgba(0,0,0,.7) 16%,
        rgba(0,0,0,.35) 28%,
        rgba(0,0,0,.22) 50%,
        rgba(0,0,0,.35) 72%,
        rgba(0,0,0,.7) 84%,
        #000 90%, #000 100%);
    mask-image:
      linear-gradient(90deg,
        #000 0%, #000 10%,
        rgba(0,0,0,.7) 16%,
        rgba(0,0,0,.35) 28%,
        rgba(0,0,0,.22) 50%,
        rgba(0,0,0,.35) 72%,
        rgba(0,0,0,.7) 84%,
        #000 90%, #000 100%);
  }
}


/* Real constellation photographic plates */
.aris-constellation-photo-stage,
#arisCosmicConstellationStage.aris-constellation-photo-stage {
  position: fixed !important;
  inset: 0 !important;
  z-index: 0 !important;
  pointer-events: none !important;
  overflow: hidden !important;
}
.aris-constellation-photo-plate {
  position: absolute;
  right: -2%;
  top: 4%;
  width: min(56vw, 780px);
  height: auto;
  max-height: 74vh;
  object-fit: cover;
  opacity: 0.26;
  filter: saturate(0.9) contrast(1.1) brightness(0.82);
  mix-blend-mode: screen;
  mask-image: radial-gradient(ellipse at 50% 45%, #000 38%, transparent 76%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 45%, #000 38%, transparent 76%);
}
.aris-constellation-photo-credit {
  position: absolute;
  right: 16px;
  bottom: 16px;
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(186, 200, 230, 0.32);
}
#arisCosmicConstellationStage svg,
#arisCosmicConstellationStage .constellation-frame,
#arisCosmicConstellationStage .zodiac-badge,
#arisCosmicConstellationStage .star-spike {
  display: none !important;
}
@media (max-width: 900px) {
  .aris-constellation-photo-plate { width: min(92vw, 540px); opacity: 0.18; }
}