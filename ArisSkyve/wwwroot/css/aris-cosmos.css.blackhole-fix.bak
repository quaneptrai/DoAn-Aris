/* =========================================================================
   ARIS CAREER STUDIO — CONSTELLATION WORKSPACE SYSTEM
   Elevated to match the cosmic visual identity and high fidelity of Auth.
   Aligned with docs/unified-theme/UI-PLAN-V2-CONSTELLATION.md
   ========================================================================= */

@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap');

:root {
  color-scheme: dark;

  /* Master Stellar Palette mapped from aris-tokens.css */
  --cosmos-void: var(--star-void, #020409);
  --cosmos-deep: var(--star-deep, #030611);
  --cosmos-ink: var(--star-ink, #070B18);
  --cosmos-panel: var(--star-ink, #070B18);
  
  /* Frosted Obsidian Glass surfaces */
  --cosmos-glass: rgba(16, 25, 45, 0.72);
  --cosmos-glass-strong: rgba(20, 31, 56, 0.85);
  --cosmos-glass-soft: rgba(13, 20, 38, 0.60);
  
  /* Starlight hairlines */
  --cosmos-hairline: var(--star-hairline, rgba(255, 255, 255, 0.08));
  --cosmos-hairline-strong: var(--star-hairline-bright, rgba(147, 197, 253, 0.22));
  
  /* High contrast typography */
  --cosmos-text: var(--star-text, #E9EEF6);
  --cosmos-text-body: var(--star-text-body, #BFCBDB);
  --cosmos-text-muted: var(--star-text-muted, #8295B3);
  --cosmos-text-faint: var(--star-text-faint, #5B6F8E);
  
  /* Celestial brand lights */
  --cosmos-cobalt: var(--star-brand, #2F6FED);
  --cosmos-azure: var(--star-azure, #7EC8F5);
  --cosmos-cyan: var(--star-cyan, #38BDF8);
  --cosmos-glow: var(--star-brand-glow, rgba(47, 111, 237, 0.38));
  
  /* Semantics */
  --cosmos-success: #34D399;
  --cosmos-warning: #FBBF24;
  --cosmos-danger: #F87171;
  --cosmos-info: #38BDF8;

  /* Shadows with ambient celestial aura */
  --cosmos-shadow-card: 0 4px 20px rgba(0, 0, 0, 0.45), 0 0 30px rgba(37, 99, 235, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  --cosmos-shadow-pop: 0 16px 45px rgba(0, 0, 0, 0.75), 0 0 40px rgba(47, 111, 237, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.16);

  /* Bootstrap Dark Mapping */
  --bs-body-bg: var(--cosmos-deep);
  --bs-body-color: var(--cosmos-text-body);
  --bs-secondary-color: var(--cosmos-text-muted);
  --bs-border-color: var(--cosmos-hairline);
  --bs-primary-text-emphasis: #93C5FD;
  --bs-success-text-emphasis: #86EFAC;
  --bs-info-text-emphasis: #7DD3FC;
  --bs-warning-text-emphasis: #FDE047;
  --bs-danger-text-emphasis: #FCA5A5;

  /* Motion physics */
  --motion-enter: 260ms;
  --motion-exit: 160ms;
  --ease-settle: cubic-bezier(0.22, 1, 0.36, 1);
}

/* =========================================================================
   1. GLOBAL COSMIC ENVIRONMENT & BACKGROUND
   Deep space void + ambient nebula glows + delicate stardust field
   ========================================================================= */
body {
  background-color: #020409 !important;
  background-image:
    /* Layer 1: Ambient nebula dust clouds - deeper and subtler */
    radial-gradient(circle at 18% 12%, rgba(29, 78, 216, 0.08) 0%, transparent 45%),
    radial-gradient(circle at 82% 18%, rgba(14, 165, 233, 0.06) 0%, transparent 40%),
    radial-gradient(circle at 50% 88%, rgba(30, 58, 138, 0.07) 0%, transparent 55%),
    /* Layer 2: Lightweight, high-precision SVG stardust field */
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400' viewBox='0 0 400 400'><g fill='%23ffffff'><circle cx='24' cy='52' r='0.75' opacity='0.45'/><circle cx='180' cy='36' r='1.1' opacity='0.7'/><circle cx='340' cy='88' r='0.6' opacity='0.35'/><circle cx='92' cy='164' r='0.9' opacity='0.5'/><circle cx='260' cy='190' r='1.2' opacity='0.8'/><circle cx='375' cy='240' r='0.7' opacity='0.4'/><circle cx='50' cy='310' r='1.0' opacity='0.6'/><circle cx='210' cy='340' r='0.65' opacity='0.35'/><circle cx='325' cy='370' r='1.15' opacity='0.75'/><circle cx='145' cy='280' r='0.8' opacity='0.45'/></g><g fill='%237ec8f5'><circle cx='120' cy='75' r='1.4' opacity='0.65'/><circle cx='295' cy='130' r='1.6' opacity='0.75'/><circle cx='70' cy='225' r='1.2' opacity='0.55'/><circle cx='240' cy='295' r='1.5' opacity='0.7'/><circle cx='360' cy='330' r='1.0' opacity='0.5'/></g></svg>") !important;
  background-attachment: fixed !important;
  color: var(--cosmos-text-body) !important;
  font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
  min-height: 100vh;
}

/* =========================================================================
   2. TYPOGRAPHY: SPACE GROTESK (DISPLAY) + INTER (DATA & BODY)
   ========================================================================= */
h1, h2, h3, h4, h5, h6,
.dashboard-heading h1, .feed-heading, .profile-rail-name,
.navbar .logo, .btn, .badge, .card-title,
.cosmos-page-head h1, .cosmos-page-head h2, .cosmos-page-title,
.modal-title, .job-mini-title {
  font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif !important;
  color: var(--cosmos-text) !important;
  letter-spacing: -0.025em;
}

h1, .cosmos-page-title {
  font-weight: 700 !important;
}

/* Radiant celestial gradient for hero headings */
.cosmos-gradient-text,
.dashboard-heading h1,
.cosmos-page-head h1 {
  background: linear-gradient(135deg, #FFFFFF 20%, #DBEAFE 65%, #60A5FA 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  display: inline-block;
}

.cosmos-page-head,
.dashboard-heading {
  position: relative;
}

@media (min-width: 992px) {
  .cosmos-page-head,
  .dashboard-heading {
    padding-right: 320px !important;
  }
}

.cosmos-page-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #93C5FD;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.cosmos-page-title {
  font-family: 'Space Grotesk', system-ui, sans-serif !important;
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.25;
  margin: 0 0 8px;
}

.cosmos-page-sub {
  color: #8BA2C4;
  font-size: 13.5px;
  line-height: 1.6;
  margin: 0;
}

.cosmos-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  background: rgba(16, 25, 45, 0.7);
  border: 1px solid rgba(147, 197, 253, 0.25);
  border-radius: 20px;
  font-size: 12px;
  color: #E2E8F0;
  backdrop-filter: blur(8px);
}

.cosmos-chip-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #34D399;
  box-shadow: 0 0 6px #34D399;
}

.cosmos-chip-dot.blue {
  background: #38BDF8;
  box-shadow: 0 0 6px #38BDF8;
}

a {
  color: #93C5FD;
  transition: color 150ms ease;
}
a:hover {
  color: #DBEAFE;
}

.text-dark, .text-body { color: var(--cosmos-text) !important; }
.text-muted, .text-secondary { color: var(--cosmos-text-muted) !important; }
.text-primary, .text-info { color: #93C5FD !important; }
.text-success { color: #34D399 !important; }
.text-warning { color: #FBBF24 !important; }
.text-danger  { color: #F87171 !important; }

::selection {
  color: #FFFFFF;
  background: rgba(47, 111, 237, 0.55);
}

/* =========================================================================
   3. OBSIDIAN FROSTED GLASS CARDS & MICRO-PHYSICS
   ========================================================================= */
.card, .aris-card, .filter-sidebar-card, .feed-composer-card,
.profile-rail-card, .jobs-rail-card, .post-card, .modal-content,
.dropdown-menu, .global-search-results, .chat-panel, .job-detail-shell {
  backdrop-filter: blur(18px) saturate(190%) !important;
  -webkit-backdrop-filter: blur(18px) saturate(190%) !important;
}

.card, .aris-card {
  background: linear-gradient(145deg, rgba(16, 25, 45, 0.72) 0%, rgba(9, 15, 30, 0.86) 100%) !important;
  color: var(--cosmos-text-body) !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-top: 1px solid rgba(147, 197, 253, 0.22) !important;
  box-shadow: var(--cosmos-shadow-card) !important;
  border-radius: 16px;
  transition: transform 180ms var(--ease-settle),
              border-color 180ms var(--ease-settle),
              box-shadow 180ms var(--ease-settle) !important;
}

.card:hover, .aris-card-interactive:hover, .post-card:hover, .cosmos-lift:hover {
  transform: translateY(-2.5px);
  border-color: rgba(147, 197, 253, 0.32) !important;
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.55),
              0 0 35px rgba(37, 99, 235, 0.12),
              inset 0 1px 0 rgba(255, 255, 255, 0.22) !important;
}

.bg-white, .bg-light {
  background-color: rgba(16, 25, 45, 0.75) !important;
  color: var(--cosmos-text-body) !important;
}
.bg-dark {
  background-color: var(--cosmos-ink) !important;
}
.border, .border-top, .border-bottom, .border-start, .border-end {
  border-color: rgba(255, 255, 255, 0.08) !important;
}
.card-header, .card-footer, .modal-header, .modal-footer {
  background: rgba(255, 255, 255, 0.02) !important;
  border-color: rgba(255, 255, 255, 0.08) !important;
}

/* Specular Hairline Dividers */
hr {
  border: 0 !important;
  height: 1px !important;
  position: relative;
  overflow: visible;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14) 15%, rgba(255, 255, 255, 0.14) 85%, transparent) !important;
  opacity: 1 !important;
  margin: 24px 0;
}
hr::before, hr::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #93C5FD;
  box-shadow: 0 0 6px #7EC8F5;
  transform: translateY(-50%);
}
hr::before { left: 14%; }
hr::after  { right: 14%; }

/* =========================================================================
   4. CELESTIAL BUTTONS (ROYAL SAPPHIRE CTA & FROSTED GLASS GHOSTS)
   ========================================================================= */
.btn {
  border-radius: 10px;
  font-weight: 550;
  font-family: 'Space Grotesk', system-ui, sans-serif;
  letter-spacing: 0.01em;
  transition: background-color 160ms ease,
              border-color 160ms ease,
              box-shadow 160ms ease,
              transform 140ms var(--ease-settle) !important;
}

.btn-primary, .btn.btn-primary {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 60%, #1E40AF 100%) !important;
  border: 1px solid rgba(147, 197, 253, 0.35) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.45) !important;
  color: #FFFFFF !important;
  box-shadow: 0 0 20px rgba(37, 99, 235, 0.40), inset 0 1px 0 rgba(255, 255, 255, 0.28) !important;
}

.btn-primary:hover, .btn.btn-primary:hover {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 60%, #1D4ED8 100%) !important;
  border-color: rgba(191, 219, 254, 0.65) !important;
  color: #FFFFFF !important;
  transform: translateY(-1.5px) !important;
  box-shadow: 0 0 28px rgba(59, 130, 246, 0.58), inset 0 1px 0 rgba(255, 255, 255, 0.45) !important;
}

.btn-primary:active {
  transform: translateY(1px) !important;
  box-shadow: 0 0 14px rgba(37, 99, 235, 0.45) !important;
}

.btn-outline-primary, .btn-outline-secondary, .btn-light, .btn-secondary, .btn-ghost {
  background: rgba(16, 25, 45, 0.55) !important;
  border: 1px solid rgba(255, 255, 255, 0.12) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.22) !important;
  color: #DBEAFE !important;
  backdrop-filter: blur(8px);
}

.btn-outline-primary:hover, .btn-outline-secondary:hover,
.btn-light:hover, .btn-secondary:hover, .btn-ghost:hover {
  background: rgba(26, 40, 72, 0.75) !important;
  border-color: rgba(147, 197, 253, 0.45) !important;
  color: #FFFFFF !important;
  transform: translateY(-1.5px) !important;
  box-shadow: 0 0 18px rgba(56, 189, 248, 0.25) !important;
}

.btn-close { filter: invert(1) grayscale(1); }

/* =========================================================================
   5. OBSIDIAN GLASS FORM CONTROLS & INPUTS
   ========================================================================= */
.form-control, .form-select, input[type=text], input[type=email],
input[type=search], input[type=password], textarea, .search-input {
  background-color: rgba(11, 18, 35, 0.75) !important;
  border: 1px solid rgba(255, 255, 255, 0.10) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.16) !important;
  color: #E2E8F0 !important;
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.35) !important;
  border-radius: 10px;
  transition: border-color 160ms var(--ease-settle),
              box-shadow 160ms var(--ease-settle),
              background-color 160ms var(--ease-settle) !important;
}

.form-control::placeholder, textarea::placeholder {
  color: rgba(148, 164, 186, 0.65) !important;
}

.form-control:focus, .form-select:focus, textarea:focus,
.SearchContainer:focus-within {
  background-color: rgba(14, 23, 46, 0.90) !important;
  border-color: #3B82F6 !important;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.28),
              0 0 16px rgba(59, 130, 246, 0.22),
              inset 0 1px 0 rgba(255, 255, 255, 0.18) !important;
  color: #FFFFFF !important;
}

.form-select option {
  background: #0E1626;
  color: #EDF1F7;
}

.form-check-input {
  background-color: rgba(11, 18, 35, 0.75) !important;
  border: 1px solid rgba(255, 255, 255, 0.16) !important;
}

.form-check-input:checked {
  background-color: #2F6FED !important;
  border-color: #93C5FD !important;
  box-shadow: 0 0 10px rgba(47, 111, 237, 0.5) !important;
}

/* =========================================================================
   6. COCKPIT NAVBAR & CONSTELLATION ACTIVE TAB
   ========================================================================= */
.navbar {
  height: 68px;
  position: sticky;
  top: 0;
  background: rgba(8, 13, 24, 0.84) !important;
  backdrop-filter: blur(24px) saturate(200%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(200%) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 -1px 0 rgba(147, 197, 253, 0.08) !important;
  z-index: 1030;
}

.navbar .logo {
  color: #F0F6FF !important;
  font-size: 22px;
  letter-spacing: -0.04em;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  text-decoration: none;
}
.navbar .logo svg {
  filter: drop-shadow(0 0 10px rgba(47, 111, 237, 0.65));
}

.navbar .nav-link {
  color: #94A4BA !important;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 500;
  position: relative;
  padding: 8px 12px;
  border-radius: 8px;
  transition: color 150ms ease, background 150ms ease;
}
.navbar .nav-link:hover {
  color: #F0F6FF !important;
  background: rgba(255, 255, 255, 0.05);
}

/* Chòm sao Active Nav Item: Hai sao + nét nối ánh sáng */
.navbar .nav-item.active .nav-link {
  color: #FFFFFF !important;
  background: rgba(47, 111, 237, 0.14) !important;
  text-shadow: 0 0 12px rgba(126, 200, 245, 0.5);
}

/* Chỉ báo mục đang chọn chuyển sang phần tử CHA: ::after của .nav-link đã
   được dùng cho lớp icon chòm sao ở mục 20, hai thứ không thể dùng chung
   một pseudo-element. */
.navbar .nav-item.active::after {
  content: "" !important;
  position: absolute !important;
  height: 3px !important;
  bottom: -13px !important;
  left: 8px !important;
  width: calc(100% - 16px) !important;
  background: linear-gradient(90deg, #7EC8F5 0%, #2F6FED 50%, #7EC8F5 100%) !important;
  box-shadow: 0 0 10px rgba(126, 200, 245, 0.9), 0 0 20px rgba(47, 111, 237, 0.6) !important;
  border-radius: 2px !important;
  animation: starLinkDraw 400ms var(--ease-settle) both !important;
}

@keyframes starLinkDraw {
  from { clip-path: inset(0 100% 0 0); opacity: 0; }
  to   { clip-path: inset(0 0 0 0);    opacity: 1; }
}

/* Avatar with orbital ring */
#navAvatar {
  border: 2px solid rgba(126, 200, 245, 0.45) !important;
  box-shadow: 0 0 16px rgba(47, 111, 237, 0.45) !important;
  transition: transform 180ms ease, box-shadow 180ms ease;
}
#navAvatar:hover {
  transform: scale(1.06);
  box-shadow: 0 0 22px rgba(56, 189, 248, 0.7) !important;
}

/* Search Capsule */
.navbar .SearchContainer {
  width: 210px;
  height: 36px;
  border: 1px solid rgba(255, 255, 255, 0.10);
  background: rgba(9, 15, 27, 0.75);
  border-radius: 10px;
  backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 10px;
  transition: border-color 160ms ease, box-shadow 160ms ease, width 200ms ease;
}
.navbar .SearchContainer:focus-within {
  width: 250px;
  border-color: rgba(147, 197, 253, 0.5);
  box-shadow: 0 0 16px rgba(47, 111, 237, 0.28);
}
.navbar .search-input {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  font-size: 12px;
  padding: 6px 0;
  color: #E2E8F0;
}
.navbar .SearchContainer svg {
  width: 15px;
  height: 15px;
  color: #8BA2C4;
}

/* Frosted Dropdowns */
.global-search-results, .dropdown-menu {
  background: rgba(14, 22, 38, 0.90) !important;
  border: 1px solid rgba(147, 197, 253, 0.22) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.25) !important;
  box-shadow: var(--cosmos-shadow-pop) !important;
  color: var(--cosmos-text-body);
  border-radius: 14px;
  padding: 8px;
}
.dropdown-item {
  color: #BFCBDB;
  border-radius: 8px;
  font-size: 13px;
  font-family: 'Space Grotesk', system-ui, sans-serif;
  transition: background 120ms ease, color 120ms ease;
}
.dropdown-item:hover, .dropdown-item:focus {
  color: #FFFFFF;
  background: rgba(47, 111, 237, 0.16);
}

/* =========================================================================
   7. STATUS BADGES & LIVE RADAR PULSE
   ========================================================================= */
.badge {
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-weight: 600;
  letter-spacing: 0.04em;
  border-radius: 6px;
  padding: 5px 10px;
}
.badge-aris-info, .badge.bg-primary {
  background: rgba(37, 99, 235, 0.18) !important;
  color: #93C5FD !important;
  border: 1px solid rgba(147, 197, 253, 0.32) !important;
  box-shadow: 0 0 10px rgba(37, 99, 235, 0.2) !important;
}
.badge-aris-success, .badge.bg-success {
  background: rgba(52, 211, 153, 0.15) !important;
  color: #A7F3D0 !important;
  border: 1px solid rgba(52, 211, 153, 0.35) !important;
  box-shadow: 0 0 10px rgba(52, 211, 153, 0.2) !important;
}
.badge-aris-warning, .badge.bg-warning {
  background: rgba(251, 191, 36, 0.15) !important;
  color: #FDE68A !important;
  border: 1px solid rgba(251, 191, 36, 0.35) !important;
}
.badge-aris-danger, .badge.bg-danger {
  background: rgba(248, 113, 113, 0.15) !important;
  color: #FECACA !important;
  border: 1px solid rgba(248, 113, 113, 0.35) !important;
}

/* Brand Status Pill with live pulse */
.cosmos-brand-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 5px 14px;
  background: rgba(14, 22, 38, 0.75);
  border: 1px solid rgba(147, 197, 253, 0.25);
  border-radius: 9999px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #C8E1FF;
}
.cosmos-pulse-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #34D399;
  box-shadow: 0 0 8px #34D399;
  animation: liveRadarPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
@keyframes liveRadarPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.75); }
}

/* Progress bar with star head */
.progress {
  background: rgba(255, 255, 255, 0.06) !important;
  border-radius: 999px !important;
  overflow: visible !important;
  height: 6px !important;
}
.progress-bar {
  background: linear-gradient(90deg, #2F6FED 0%, #7EC8F5 100%) !important;
  border-radius: 999px !important;
  position: relative;
  overflow: visible !important;
}
.progress-bar::after {
  content: "";
  position: absolute;
  right: -3px;
  top: 50%;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  transform: translateY(-50%);
  background: #FFFFFF;
  box-shadow: 0 0 10px 2px rgba(126, 200, 245, 0.9);
}

/* =========================================================================
   8. WORKSPACE SECTIONS & SURFACES
   ========================================================================= */
.cosmos-page-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
  padding: 16px 0 28px;
  margin-bottom: 28px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.cosmos-page-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-weight: 600;
  color: #93C5FD;
  margin-bottom: 8px;
}
.cosmos-page-sub {
  font-size: 13px;
  color: var(--cosmos-text-muted);
  max-width: 620px;
  line-height: 1.8;
  margin: 0;
}

/* Tables in workspace */
.table {
  --bs-table-bg: transparent;
  --bs-table-color: var(--cosmos-text-body);
  --bs-table-border-color: rgba(255, 255, 255, 0.08);
  --bs-table-hover-bg: rgba(47, 111, 237, 0.06);
  --bs-table-hover-color: #FFFFFF;
}
.table thead th {
  color: #93C5FD;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border-bottom: 1px solid rgba(147, 197, 253, 0.22);
  padding: 14px 12px;
}
.table tbody td {
  padding: 14px 12px;
  vertical-align: middle;
}

/* Pagination */
.pagination {
  --bs-pagination-bg: rgba(14, 22, 38, 0.7);
  --bs-pagination-color: var(--cosmos-text-body);
  --bs-pagination-border-color: rgba(255, 255, 255, 0.10);
  --bs-pagination-hover-bg: rgba(47, 111, 237, 0.2);
  --bs-pagination-hover-color: #FFFFFF;
  --bs-pagination-active-bg: #2F6FED;
  --bs-pagination-active-border-color: #93C5FD;
}
.page-link {
  border-radius: 8px !important;
  margin: 0 3px;
  font-family: 'Space Grotesk', sans-serif;
}

/* Empty States */
.feed-empty-state, .cosmos-empty {
  text-align: center;
  padding: 50px 30px;
  background: rgba(14, 22, 38, 0.45);
  border: 1px solid rgba(147, 197, 253, 0.16);
  border-radius: 16px;
  position: relative;
  overflow: hidden;
}
.feed-empty-icon, .cosmos-empty-orbit {
  display: grid;
  place-items: center;
  width: 56px;
  height: 56px;
  margin: 0 auto 18px;
  border-radius: 16px;
  border: 1px solid rgba(147, 197, 253, 0.28);
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.25), rgba(14, 22, 38, 0.85));
  color: #93C5FD;
  box-shadow: 0 0 25px rgba(37, 99, 235, 0.35);
}

/* Footer */
.cosmos-app-footer {
  padding: 28px 0;
  margin-top: 48px;
  color: #7E92AB;
  font-size: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

/* Accessibility skip link */
.skip-link {
  position: fixed !important;
  top: -120px !important;
  left: 16px !important;
  z-index: 9999 !important;
  padding: 10px 18px !important;
  border-radius: 8px !important;
  background: #2563EB !important;
  color: #FFFFFF !important;
  font-family: 'Space Grotesk', sans-serif !important;
  font-weight: 600 !important;
  text-decoration: none !important;
  transition: top 160ms ease !important;
}
.skip-link:focus {
  top: 16px !important;
}


/* =========================================================================
   9. 12 ZODIAC CONSTELLATION WATERMARK SYSTEM
   Radiant star nodes + fine starlight beams + Latin-Vietnamese badge
   ========================================================================= */
main {
  position: relative;
}

main::before {
  content: "";
  position: absolute;
  top: 4px;
  right: 18px;
  width: 280px;
  height: 160px;
  z-index: 0;
  pointer-events: none;
  opacity: 0;
  background-repeat: no-repeat;
  background-position: top right;
  background-image: var(--page-figure, none);
  filter: drop-shadow(0 0 10px rgba(126, 200, 245, 0.45));
  animation: zodiacDraw 800ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both;
}

main::after {
  content: var(--page-name, "");
  position: absolute;
  top: 154px;
  right: 22px;
  z-index: 0;
  pointer-events: none;
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.30em;
  color: rgba(200, 225, 255, 0.75);
  text-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
  animation: zodiacDraw 800ms cubic-bezier(0.22, 1, 0.36, 1) 320ms both;
}

@keyframes zodiacDraw {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 0.62; transform: none; }
}

@media (max-width: 991px) {
  main::before, main::after { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  main::before, main::after { animation: none !important; opacity: 0.5; }
}

