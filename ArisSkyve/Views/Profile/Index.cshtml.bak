@model ArisSkyve.Domain.Entities.User
@using System.Text.Json
@using ArisSkyve.Domain.Entities
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var profile = Model.Profile;
    var business = profile as BussinessAccount;
    var hasResume = profile?.Resumes != null && profile.Resumes.Any();
    var latestResume = hasResume ? profile.Resumes.OrderByDescending(r => r.LastUpdatedAt).First() : null;

    var fullName = !string.IsNullOrEmpty(profile?.FullName) ? profile.FullName : Model.Username;
    var avatar = !string.IsNullOrEmpty(profile?.AvatarUrl) ? profile.AvatarUrl : "/images/default-avatar.png";
    var cover = !string.IsNullOrEmpty(profile?.CoverPhotoUrl) ? profile.CoverPhotoUrl : "https://images.unsplash.com/photo-1579546929518-9e396f3cc809?w=1200&auto=format&fit=crop&q=80";
    var bio = profile?.Bio ?? "Chưa có tiểu sử.";
    var location = profile?.Location ?? "Chưa cập nhật";
    var jobTitle = profile?.JobTitle ?? (Model.Role == "Business" ? "Doanh nghiệp" : "Chuyên viên");

    // Featured skills from CV builder or AI relational skills
    var topSkills = new List<string>();
    if (latestResume != null)
    {
        if (!string.IsNullOrWhiteSpace(latestResume.BuilderDataJson))
        {
            try
            {
                using var builderDoc = JsonDocument.Parse(latestResume.BuilderDataJson);
                if (builderDoc.RootElement.TryGetProperty("sections", out var sectionsEl) && sectionsEl.ValueKind == JsonValueKind.Array)
                {
                    foreach (var section in sectionsEl.EnumerateArray())
                    {
                        var catalogId = section.TryGetProperty("catalogId", out var catEl) ? catEl.GetString() : null;
                        if (catalogId == "skills" && section.TryGetProperty("items", out var itemsEl) && itemsEl.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var item in itemsEl.EnumerateArray())
                            {
                                if (item.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(item.GetString()))
                                {
                                    topSkills.Add(item.GetString()!);
                                }
                            }
                            break;
                        }
                    }
                }
            }
            catch (JsonException) { }
        }

        if (topSkills.Count == 0 && latestResume.Skills != null)
        {
            topSkills = latestResume.Skills
                .Select(s => s.SkillName)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .ToList();
        }
    }

    var resumeBtnText = hasResume ? "Cập nhật hồ sơ qua AI" : "Tải lên CV (AI Scan)";
    var resumeBtnIcon = hasResume ? "repeat" : "upload-cloud";

    int readiness = ViewBag.ProfileReadiness != null ? (int)ViewBag.ProfileReadiness : 20;
    var recentJobs = ViewBag.RecentJobs as List<JobPosting> ?? new List<JobPosting>();

    ViewData["Title"] = fullName + " - Hồ sơ";
    ViewData["ActiveNav"] = "Profile";
    Layout = "_AppLayout";
}

@section Styles {
    <style>
        .card-aris {
            background: linear-gradient(155deg, rgba(17, 26, 44, 0.85) 0%, rgba(10, 16, 28, 0.95) 100%) !important;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(178, 212, 255, 0.16) !important;
            border-radius: 16px;
            box-shadow: 0 18px 48px -16px rgba(2, 5, 14, 0.8);
            transition: box-shadow 0.2s ease, border-color 0.2s ease;
            color: #E2E8F0;
        }

        .card-aris:hover { border-color: rgba(126, 200, 245, 0.35) !important; }

        .card-aris .text-dark { color: #F1F5F9 !important; }
        .card-aris .text-secondary { color: #94A3B8 !important; }
        .card-aris .bg-light {
            background: rgba(255, 255, 255, 0.04) !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
            color: #CBD5E1 !important;
        }

        .profile-cover {
            height: 140px;
            background-image: url('@cover');
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .profile-cover::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(6, 9, 19, 0.08) 20%, rgba(15, 24, 47, 0.95) 100%);
        }

        .profile-avatar-container {
            margin-top: -55px;
            position: relative;
            z-index: 2;
        }

        .avatar-main {
            width: 104px;
            height: 104px;
            border-radius: 50%;
            border: 3px solid rgba(126, 200, 245, 0.5);
            object-fit: cover;
            box-shadow: 0 0 30px rgba(47, 111, 237, 0.55);
            background: #0E1730;
        }

        .contact-item {
            display: flex;
            align-items: center;
            padding: 9px 12px;
            border-radius: 10px;
            transition: all 0.2s;
            color: #A9B8CE;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.07);
            margin-bottom: 8px;
        }

        .contact-item:hover {
            background: rgba(47, 111, 237, 0.18);
            color: #93C5FD;
            border-color: rgba(96, 165, 250, 0.4);
        }

        .skill-badge {
            background: rgba(255, 255, 255, 0.05);
            color: #C9D6E8;
            font-size: 0.78rem;
            padding: 6px 12px;
            border-radius: 999px;
            font-weight: 500;
            border: 1px solid rgba(255, 255, 255, 0.11);
        }

        .profile-tabs .nav-link {
            color: #8CA0BC;
            font-weight: 600;
            font-size: 14px;
            border-radius: 12px;
            padding: 9px 20px;
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .profile-tabs .nav-link.active {
            background: rgba(47, 111, 237, 0.35);
            color: #ffffff;
            box-shadow: 0 0 18px rgba(47, 111, 237, 0.4);
        }

        .profile-tabs .nav-link:hover:not(.active) {
            background: rgba(255, 255, 255, 0.06);
            color: #EDF2FA;
        }

        .typing-effect {
            display: inline-block;
            position: relative;
        }

        .typing-cursor::after {
            content: '|';
            position: absolute;
            right: -8px;
            animation: blink 0.8s step-end infinite;
            color: #7EC8F5;
            font-weight: bold;
        }

        @@keyframes blink {
            50% { opacity: 0; }
        }
    </style>
}

<div class="aris-container py-4">
    <!-- Constellation Page Header -->
    <div class="cosmos-page-head mb-4">
        <div class="cosmos-page-head-inner">
            <span class="cosmos-page-eyebrow">
                <i data-lucide="sparkles" style="width: 13px; height: 13px;"></i> Hồ sơ chuyên nghiệp & Định danh
            </span>
            <h1 class="cosmos-page-title"><span class="cosmos-gradient-text">Không gian cá nhân & Năng lực</span></h1>
            <p class="cosmos-page-sub">Quản lý định danh nghề nghiệp, danh mục kỹ năng và kết nối cơ hội việc làm cùng Aris AI.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Identity & Contacts & CV Summary -->
        <div class="col-lg-3">
            <!-- Identity Card -->
            <div class="card-aris overflow-hidden mb-4">
                <div class="profile-cover"></div>
                <div class="px-4 pb-4 text-center">
                    <div class="profile-avatar-container">
                        <img src="@avatar" alt="@fullName" class="avatar-main">
                    </div>
                    <h5 class="fw-bold mt-3 mb-1 text-dark">@fullName</h5>
                    <p class="text-muted small mb-3">@@@Model.Username &bull; @jobTitle</p>

                    <div class="row g-2 mt-1">
                        <div class="col-6">
                            <div class="bg-light rounded-3 p-2 text-center border">
                                <div class="fw-bold text-dark fs-6">@Model.Posts.Count</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">Bài viết</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-light rounded-3 p-2 text-center border">
                                <div class="fw-bold text-dark fs-6">@Model.Likes.Count</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">Lượt thích</div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 opacity-50">

                    <!-- Bio Section -->
                    <div class="text-start mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-uppercase fw-bold text-muted" style="letter-spacing: 0.5px; font-size: 11px;">Tiểu sử</span>
                            <button class="btn btn-sm btn-link text-primary p-0 text-decoration-none" id="btnEditBio" title="Chỉnh sửa tiểu sử">
                                <i data-lucide="square-pen" style="width: 15px; height: 15px;"></i>
                            </button>
                        </div>

                        <div id="bioDisplayMode">
                            <p id="bioText" class="small text-secondary mb-0">@bio</p>
                        </div>

                        <div id="bioEditMode" class="d-none mt-2">
                            <textarea id="bioInput" class="form-control form-control-sm mb-2 rounded-3" rows="3">@bio</textarea>
                            <div class="d-flex justify-content-end gap-2">
                                <button id="btnCancelBio" class="btn btn-sm btn-light rounded-pill px-3 fw-medium">Hủy</button>
                                <button id="btnSaveBio" class="btn btn-sm btn-primary rounded-pill px-3 fw-medium">
                                    <span id="saveBioSpinner" class="spinner-border spinner-border-sm d-none me-1"></span> Lưu
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Location Section -->
                    <div class="text-start">
                        <span class="small text-uppercase fw-bold text-muted d-block mb-1" style="letter-spacing: 0.5px; font-size: 11px;">Vị trí</span>
                        <div class="small text-secondary d-flex align-items-center gap-1">
                            <i data-lucide="map-pin" class="text-primary" style="width: 15px; height: 15px;"></i>
                            <span>@location</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Methods Card -->
            <div class="card-aris p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-dark">Liên hệ</h6>
                    <button class="btn btn-sm btn-light text-primary rounded-circle p-1" data-bs-toggle="modal" data-bs-target="#addContactModal" title="Thêm liên hệ">
                        <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
                    </button>
                </div>

                <div class="contact-list">
                    @if (profile?.ContactMethods != null && profile.ContactMethods.Any())
                    {
                        foreach (var method in profile.ContactMethods)
                        {
                            var methodIcon = method.MethodType switch
                            {
                                ContactMethodType.Phone => "phone",
                                ContactMethodType.Email => "mail",
                                ContactMethodType.LinkedIn => "linkedin",
                                ContactMethodType.GitHub => "github",
                                ContactMethodType.Facebook => "facebook",
                                _ => "link"
                            };

                            var href = method.MethodType switch
                            {
                                ContactMethodType.Phone => $"tel:{method.Value}",
                                ContactMethodType.Email => $"mailto:{method.Value}",
                                _ => method.Value.StartsWith("http") ? method.Value : $"https://{method.Value}"
                            };

                            <a href="@href" target="_blank" rel="noopener" class="contact-item">
                                <i data-lucide="@methodIcon" class="me-2 text-primary flex-shrink-0" style="width: 16px; height: 16px;"></i>
                                <div class="text-truncate">
                                    <div class="small fw-semibold text-dark">@method.MethodType</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@method.Value</div>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="small text-muted mb-0 text-center py-2 fst-italic">Chưa có thông tin liên hệ.</p>
                    }
                </div>
            </div>

            @if (Model.Role == "Business")
            {
                <!-- Business Account Details -->
                <div class="card-aris p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-dark">Thông tin doanh nghiệp</h6>
                        @if (business?.IsVerified == true)
                        {
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1" style="font-size: 11px;">
                                <i data-lucide="badge-check" class="me-1" style="width: 12px; height: 12px;"></i>Đã xác minh
                            </span>
                        }
                    </div>
                    <div class="mb-3">
                        <span class="small text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 11px;">Lĩnh vực</span>
                        <div class="small text-dark d-flex align-items-center gap-2">
                            <i data-lucide="briefcase" class="text-primary" style="width: 15px; height: 15px;"></i>
                            <span>@(business?.Industry ?? "Chưa cập nhật")</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <span class="small text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 11px;">Quy mô</span>
                        <div class="small text-dark d-flex align-items-center gap-2">
                            <i data-lucide="users" class="text-primary" style="width: 15px; height: 15px;"></i>
                            <span>@(business?.CompanySize ?? "Chưa cập nhật")</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(business?.WebsiteUrl))
                    {
                        <div class="mb-3">
                            <span class="small text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 11px;">Website</span>
                            <a href="@business.WebsiteUrl" target="_blank" rel="noopener" class="small text-primary text-decoration-none text-truncate d-block">
                                <i data-lucide="globe" class="me-1" style="width: 14px; height: 14px;"></i>@business.WebsiteUrl
                            </a>
                        </div>
                    }
                    <div class="d-flex flex-column gap-2 mt-3">
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary rounded-pill py-2 w-100 fw-semibold text-center">
                            <i data-lucide="briefcase" class="me-1" style="width: 16px; height: 16px;"></i> Quản lý tin tuyển dụng
                        </a>
                        @if (business != null)
                        {
                            <a asp-controller="Company" asp-action="Details" asp-route-id="@business.Id" class="btn btn-outline-secondary rounded-pill py-2 w-100 fw-semibold text-center">
                                <i data-lucide="building" class="me-1" style="width: 16px; height: 16px;"></i> Xem trang công ty
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Candidate CV Card -->
                <div class="card-aris p-4 mb-4 border-primary border-opacity-25">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-dark">CV của bạn</h6>
                        @if (hasResume)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1" style="font-size: 11px;">
                                <i data-lucide="check-circle" class="me-1" style="width: 12px; height: 12px;"></i>Đã phân tích
                            </span>
                        }
                    </div>

                    @if (hasResume && latestResume != null)
                    {
                        @if (!string.IsNullOrWhiteSpace(latestResume.PreviewImageUrl))
                        {
                            <a href="/Resume/OpenCv?url=@Uri.EscapeDataString(latestResume.FileUrl ?? "")" target="_blank" rel="noopener" class="d-block mb-3 text-decoration-none">
                                <img src="/Resume/OpenCv?url=@Uri.EscapeDataString(latestResume.PreviewImageUrl)" alt="Xem trước CV" class="w-100 rounded-3 border" style="max-height: 200px; object-fit: cover; object-position: top;">
                            </a>
                        }
                        else if (!string.IsNullOrWhiteSpace(latestResume.FileUrl))
                        {
                            <a href="/Resume/OpenCv?url=@Uri.EscapeDataString(latestResume.FileUrl)" target="_blank" rel="noopener" class="d-flex align-items-center gap-2 p-3 rounded-3 mb-3 text-decoration-none border bg-light">
                                <i data-lucide="file-text" class="text-primary fs-4"></i>
                                <div>
                                    <span class="small fw-bold text-primary d-block">Xem file CV gốc</span>
                                    <span class="text-muted" style="font-size: 11px;">PDF / Word Document</span>
                                </div>
                            </a>
                        }
                        <div class="p-3 rounded-3 mb-3 bg-light border">
                            <div class="small fw-bold mb-1 text-truncate text-primary d-flex align-items-center">
                                <i data-lucide="sparkles" class="me-1" style="width: 14px; height: 14px;"></i> @(string.IsNullOrWhiteSpace(latestResume.Category) ? "Hồ sơ ứng viên" : latestResume.Category)
                            </div>
                            <div class="text-muted" style="font-size: 11px;">
                                <i data-lucide="clock" class="me-1" style="width: 12px; height: 12px;"></i> Cập nhật: @latestResume.LastUpdatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="small text-muted mb-3">Hãy tải lên CV để AI phân tích kỹ năng và tự động gợi ý việc làm phù hợp nhất.</p>
                    }

                    <button id="btnUploadCv" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm mb-2" onclick="document.getElementById('cvFileInput').click()">
                        <i data-lucide="@resumeBtnIcon" class="me-1" style="width: 16px; height: 16px;"></i> @resumeBtnText
                    </button>

                    <input type="file" id="cvFileInput" accept=".pdf,.doc,.docx" class="d-none" onchange="uploadCV(this)">

                    <div id="cvUploadStatus" class="d-none mb-3">
                        <div class="d-flex align-items-center justify-content-center p-2 rounded-3 bg-light border">
                            <div id="cvSpinner" class="spinner-border spinner-border-sm text-primary me-2"></div>
                            <i data-lucide="check-circle" class="text-success me-2 d-none" id="cvSuccessIcon" style="width: 16px; height: 16px;"></i>
                            <span class="small fw-semibold text-primary" id="statusText">AI đang phân tích CV...</span>
                        </div>
                    </div>

                    <a href="/cv-builder/picker.html?scratch=1" class="btn btn-outline-secondary w-100 py-2 rounded-pill fw-semibold mb-2">
                        <i data-lucide="file-plus" class="me-1" style="width: 16px; height: 16px;"></i> Tạo CV mới từ đầu
                    </a>

                    @if (hasResume)
                    {
                        <button type="button" class="btn btn-link text-danger w-100 py-1 text-decoration-none small" data-bs-toggle="modal" data-bs-target="#deleteResumeModal">
                            <i data-lucide="trash-2" class="me-1" style="width: 14px; height: 14px;"></i> Xóa CV này
                        </button>
                    }
                </div>

                <!-- Featured Skills Card -->
                <div class="card-aris p-4 mb-4">
                    <h6 class="fw-bold mb-3 text-dark">Kỹ năng nổi bật</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @if (topSkills.Any())
                        {
                            foreach (var skill in topSkills.Take(8))
                            {
                                <span class="skill-badge">@skill</span>
                            }
                            if (topSkills.Count > 8)
                            {
                                <span class="skill-badge text-primary bg-primary-subtle">+@(topSkills.Count - 8) nữa</span>
                            }
                        }
                        else
                        {
                            <p class="small text-muted mb-0 fst-italic">Chưa có kỹ năng nào. Cập nhật CV để AI nhận diện.</p>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Center Column: Tabs, Feed, CVs, Applications -->
        <div class="col-lg-6">
            @if (Model.Role != "Business")
            {
                <ul class="nav nav-pills profile-tabs mb-3 p-2 rounded-4" id="profileTabs">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-posts" type="button">
                            <i data-lucide="newspaper" class="me-1" style="width: 16px; height: 16px;"></i> Bài viết
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="cvsTabBtn" data-bs-toggle="pill" data-bs-target="#tab-cvs" type="button">
                            <i data-lucide="file-text" class="me-1" style="width: 16px; height: 16px;"></i> CV của tôi
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="applicationsTabBtn" data-bs-toggle="pill" data-bs-target="#tab-applications" type="button">
                            <i data-lucide="send" class="me-1" style="width: 16px; height: 16px;"></i> Đơn ứng tuyển
                        </button>
                    </li>
                </ul>
            }

            <div class="tab-content">
                <!-- Tab: Posts -->
                <div class="tab-pane fade show active" id="tab-posts">
                    <!-- Composer trigger -->
                    <div class="card-aris p-3 mb-4">
                        <div class="d-flex gap-3 align-items-center">
                            <img src="@avatar" class="rounded-circle border" width="44" height="44" style="object-fit: cover;">
                            <div class="form-control rounded-pill bg-light border text-muted px-3 py-2 cursor-pointer flex-grow-1" style="cursor: pointer;" onclick="window.location.href='/Dashboard/Index#composer'">
                                Bạn đang nghĩ gì, @((profile?.FullName ?? Model.Username).Split(' ')[0])?
                            </div>
                        </div>
                    </div>

                    <!-- Posts List -->
                    @if (Model.Posts != null && Model.Posts.Any())
                    {
                        foreach (var post in Model.Posts.OrderByDescending(p => p.Id))
                        {
                            <div class="card-aris p-4 mb-4" data-post-id="@post.Id">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@avatar" class="rounded-circle border" width="42" height="42" style="object-fit: cover;">
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@fullName</h6>
                                            <small class="text-muted">@post.CreatedAt.ToString("g") &bull; <i data-lucide="globe" style="width: 12px; height: 12px;"></i></small>
                                        </div>
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-link text-muted p-1 text-decoration-none" data-bs-toggle="dropdown">
                                            <i data-lucide="more-horizontal" style="width: 18px; height: 18px;"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                            <li>
                                                <button type="button" class="dropdown-item py-2 edit-post-btn" data-id="@post.Id">
                                                    <i data-lucide="pencil" class="me-2 text-muted" style="width: 15px; height: 15px;"></i> Sửa bài viết
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item py-2 text-danger delete-post-btn" data-id="@post.Id">
                                                    <i data-lucide="trash-2" class="me-2" style="width: 15px; height: 15px;"></i> Xóa bài viết
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <p class="post-content-text mb-3 text-dark" style="white-space: pre-wrap; line-height: 1.6;">@post.Content</p>
                                <div class="d-flex gap-4 pt-2 border-top">
                                    <span class="small text-muted cursor-pointer d-flex align-items-center gap-1" style="cursor: pointer;">
                                        <i data-lucide="heart" style="width: 16px; height: 16px;"></i> Thích
                                    </span>
                                    <span class="small text-muted cursor-pointer d-flex align-items-center gap-1" style="cursor: pointer;">
                                        <i data-lucide="message-circle" style="width: 16px; height: 16px;"></i> Bình luận
                                    </span>
                                    <span class="small text-muted cursor-pointer ms-auto d-flex align-items-center gap-1" style="cursor: pointer;">
                                        <i data-lucide="share-2" style="width: 16px; height: 16px;"></i> Chia sẻ
                                    </span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="card-aris p-5 text-center">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                                <i data-lucide="newspaper" class="text-primary opacity-50" style="width: 32px; height: 32px;"></i>
                            </div>
                            <h6 class="fw-bold text-dark">Chưa có bài viết nào</h6>
                            <p class="text-muted small mb-0">Khi bạn đăng bài viết, các nội dung sẽ xuất hiện tại đây.</p>
                        </div>
                    }
                </div>

                @if (Model.Role != "Business")
                {
                    <!-- Tab: My CVs (Lazy Loaded) -->
                    <div class="tab-pane fade" id="tab-cvs">
                        <div id="cvsTabContent" class="text-center text-muted py-5">
                            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                            <span>Đang tải danh sách CV...</span>
                        </div>
                    </div>

                    <!-- Tab: Applications (Lazy Loaded) -->
                    <div class="tab-pane fade" id="tab-applications">
                        <div id="applicationsTabContent" class="text-center text-muted py-5">
                            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                            <span>Đang tải đơn ứng tuyển...</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Preferences, Readiness, Recommended Jobs -->
        <div class="col-lg-3">
            <!-- Work Status Preferences Card -->
            <div class="card-aris p-4 mb-4">
                <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                    <i data-lucide="settings-2" class="text-primary" style="width: 18px; height: 18px;"></i> Trạng thái làm việc
                </h6>
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light border mb-2">
                    <span class="small fw-semibold text-dark">Làm việc từ xa</span>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" id="prefRemoteJob" @(profile?.IsRemoteJob == true ? "checked" : "") onchange="updateWorkPreferences()">
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light border mb-2">
                    <span class="small fw-semibold text-dark">Tìm việc làm mới</span>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input" type="checkbox" id="prefLookingJob" @(profile?.IsLookingForJob == true ? "checked" : "") onchange="updateWorkPreferences()">
                    </div>
                </div>
                <small class="text-muted d-block" style="font-size: 11px;">Bật trạng thái để nhà tuyển dụng dễ dàng tiếp cận hồ sơ của bạn.</small>
            </div>

            <!-- Real Profile Readiness Card (Replaces fake 124 views stat) -->
            <div class="card-aris p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0 text-dark">Độ hoàn thiện hồ sơ</h6>
                    <span class="badge bg-primary text-white rounded-pill px-2 py-1">@readiness%</span>
                </div>
                <div class="progress mb-3" style="height: 8px; border-radius: 999px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @readiness%;" aria-valuenow="@readiness" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="small">
                    <div class="d-flex align-items-center gap-2 mb-2 @(!string.IsNullOrWhiteSpace(profile?.AvatarUrl) ? "text-success" : "text-muted")">
                        <i data-lucide="@(!string.IsNullOrWhiteSpace(profile?.AvatarUrl) ? "check-circle-2" : "circle")" style="width: 15px; height: 15px;"></i>
                        <span>Ảnh đại diện</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2 @(!string.IsNullOrWhiteSpace(profile?.Bio) && profile.Bio != "Chưa có tiểu sử." ? "text-success" : "text-muted")">
                        <i data-lucide="@(!string.IsNullOrWhiteSpace(profile?.Bio) && profile.Bio != "Chưa có tiểu sử." ? "check-circle-2" : "circle")" style="width: 15px; height: 15px;"></i>
                        <span>Tiểu sử giới thiệu</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2 @(!string.IsNullOrWhiteSpace(profile?.Location) && profile.Location != "Chưa cập nhật" ? "text-success" : "text-muted")">
                        <i data-lucide="@(!string.IsNullOrWhiteSpace(profile?.Location) && profile.Location != "Chưa cập nhật" ? "check-circle-2" : "circle")" style="width: 15px; height: 15px;"></i>
                        <span>Vị trí sinh sống</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2 @(profile?.ContactMethods != null && profile.ContactMethods.Any() ? "text-success" : "text-muted")">
                        <i data-lucide="@(profile?.ContactMethods != null && profile.ContactMethods.Any() ? "check-circle-2" : "circle")" style="width: 15px; height: 15px;"></i>
                        <span>Phương thức liên hệ</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 @(hasResume ? "text-success" : "text-muted")">
                        <i data-lucide="@(hasResume ? "check-circle-2" : "circle")" style="width: 15px; height: 15px;"></i>
                        <span>CV chuyên môn</span>
                    </div>
                </div>
            </div>

            <!-- Real Jobs Preview (Replaces fake Google/Microsoft jobs) -->
            <div class="card-aris p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-dark">Việc làm gợi ý</h6>
                    <a asp-controller="Jobs" asp-action="Index" class="small fw-semibold text-primary text-decoration-none">Xem tất cả</a>
                </div>

                @if (recentJobs.Any())
                {
                    foreach (var job in recentJobs)
                    {
                        <div class="d-flex align-items-start gap-3 mb-3 pb-3 border-bottom">
                            <div class="p-2 rounded-3 bg-primary-subtle text-primary flex-shrink-0">
                                <i data-lucide="briefcase" style="width: 18px; height: 18px;"></i>
                            </div>
                            <div class="text-truncate flex-grow-1">
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="small fw-bold text-dark text-decoration-none d-block text-truncate">
                                    @job.Title
                                </a>
                                <div class="text-muted" style="font-size: 11px;">
                                    @(job.Company ?? "Aris Partner") &bull; @(string.IsNullOrWhiteSpace(job.Salary) ? "Thỏa thuận" : job.Salary)
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="small text-muted mb-0 fst-italic">Hiện chưa có tin tuyển dụng phù hợp mới.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Thêm phương thức liên hệ -->
<div class="modal fade" id="addContactModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <form asp-controller="Profile" asp-action="AddContact" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold text-dark">Thêm phương thức liên hệ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Loại liên hệ (Nền tảng)</label>
                        <select name="MethodType" class="form-select rounded-3" required>
                            <option value="" disabled selected>Chọn nền tảng...</option>
                            <option value="@ContactMethodType.Phone">Số điện thoại</option>
                            <option value="@ContactMethodType.Email">Email</option>
                            <option value="@ContactMethodType.LinkedIn">LinkedIn</option>
                            <option value="@ContactMethodType.GitHub">GitHub</option>
                            <option value="@ContactMethodType.Facebook">Facebook</option>
                            <option value="@ContactMethodType.Other">Khác</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-muted">Giá trị / Đường dẫn</label>
                        <input type="text" name="Value" class="form-control rounded-3" placeholder="VD: linkedin.com/in/arisskyve" required>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-2">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">Thêm liên hệ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Xóa CV -->
<div class="modal fade" id="deleteResumeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2">
                    <i data-lucide="alert-triangle" style="width: 20px; height: 20px;"></i> Xóa CV?
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <p class="text-secondary small mb-0">Bạn có chắc chắn muốn xóa CV này? Toàn bộ dữ liệu kỹ năng, kinh nghiệm và bản CV đã lưu sẽ bị xóa vĩnh viễn.</p>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-2">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" id="btnConfirmDeleteResume">
                    <span id="deleteResumeSpinner" class="spinner-border spinner-border-sm d-none me-1"></span> Xóa CV
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/resume-actions.js" asp-append-version="true"></script>
    <script src="~/js/application-actions.js" asp-append-version="true"></script>
    <script src="~/js/post-actions.js" asp-append-version="true"></script>

    <script>
        // Lazy load CVs and Applications tabs
        $(function () {
            let cvsLoaded = false, applicationsLoaded = false;

            $('#cvsTabBtn').on('shown.bs.tab', function () {
                if (cvsLoaded) return;
                cvsLoaded = true;
                $.get('/Resume/Index')
                    .done(function (html) { 
                        $('#cvsTabContent').html(html); 
                        if (window.lucide) lucide.createIcons();
                    })
                    .fail(function () { 
                        $('#cvsTabContent').html('<div class="text-center text-danger py-5">Không thể tải danh sách CV. Vui lòng thử lại sau.</div>'); 
                    });
            });

            $('#applicationsTabBtn').on('shown.bs.tab', function () {
                if (applicationsLoaded) return;
                applicationsLoaded = true;
                $.get('/JobApplications/MyApplications')
                    .done(function (html) { 
                        $('#applicationsTabContent').html(html); 
                        if (window.lucide) lucide.createIcons();
                    })
                    .fail(function () { 
                        $('#applicationsTabContent').html('<div class="text-center text-danger py-5">Không thể tải danh sách đơn ứng tuyển. Vui lòng thử lại sau.</div>'); 
                    });
            });
        });

        // Bio inline editing with typewriter animation
        document.addEventListener("DOMContentLoaded", function () {
            const bioText = document.getElementById("bioText");
            const btnEditBio = document.getElementById("btnEditBio");
            const bioDisplayMode = document.getElementById("bioDisplayMode");
            const bioEditMode = document.getElementById("bioEditMode");
            const bioInput = document.getElementById("bioInput");
            const btnCancelBio = document.getElementById("btnCancelBio");
            const btnSaveBio = document.getElementById("btnSaveBio");
            const spinner = document.getElementById("saveBioSpinner");

            if (btnEditBio && bioInput && btnSaveBio) {
                let currentBio = bioText.innerText;

                btnEditBio.addEventListener("click", () => {
                    bioDisplayMode.classList.add("d-none");
                    bioEditMode.classList.remove("d-none");
                    bioInput.focus();
                });

                btnCancelBio.addEventListener("click", () => {
                    bioInput.value = currentBio;
                    bioEditMode.classList.add("d-none");
                    bioDisplayMode.classList.remove("d-none");
                });

                function typeWriterEffect(element, text, speed = 25) {
                    element.innerHTML = "";
                    element.classList.add("typing-cursor", "typing-effect");

                    let i = 0;
                    function type() {
                        if (i < text.length) {
                            element.innerHTML += text.charAt(i);
                            i++;
                            setTimeout(type, speed);
                        } else {
                            setTimeout(() => element.classList.remove("typing-cursor"), 1000);
                        }
                    }
                    type();
                }

                btnSaveBio.addEventListener("click", async () => {
                    const newBio = bioInput.value.trim();
                    if (newBio === currentBio) {
                        btnCancelBio.click();
                        return;
                    }

                    btnSaveBio.disabled = true;
                    spinner.classList.remove("d-none");

                    try {
                        const response = await fetch('/Profile/UpdateBio', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ Bio: newBio })
                        });

                        if (response.ok) {
                            const result = await response.json();
                            if (result.success) {
                                currentBio = newBio;
                                bioEditMode.classList.add("d-none");
                                bioDisplayMode.classList.remove("d-none");
                                typeWriterEffect(bioText, currentBio);
                                if (window.showToast) window.showToast("Đã cập nhật tiểu sử thành công!", "success");
                            }
                        } else {
                            if (window.showToast) window.showToast("Không thể lưu tiểu sử. Vui lòng thử lại!", "danger");
                        }
                    } catch (error) {
                        console.error("Lỗi:", error);
                        if (window.showToast) window.showToast("Lỗi kết nối máy chủ!", "danger");
                    } finally {
                        btnSaveBio.disabled = false;
                        spinner.classList.add("d-none");
                    }
                });
            }
        });

        // Work Preferences AJAX toggle
        window.updateWorkPreferences = async function () {
            const isRemote = document.getElementById('prefRemoteJob').checked;
            const isLooking = document.getElementById('prefLookingJob').checked;

            try {
                const response = await fetch('/Profile/UpdatePreferences', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ IsRemoteJob: isRemote, IsLookingForJob: isLooking })
                });
                if (response.ok) {
                    if (window.showToast) window.showToast("Đã cập nhật trạng thái làm việc!", "success");
                } else {
                    if (window.showToast) window.showToast("Không thể lưu trạng thái làm việc.", "danger");
                }
            } catch (err) {
                console.error(err);
                if (window.showToast) window.showToast("Lỗi kết nối khi cập nhật trạng thái.", "danger");
            }
        };

        // CV upload AI pipeline
        window.uploadCV = async function (input) {
            if (!input.files || input.files.length === 0) return;

            const file = input.files[0];
            const statusDiv = document.getElementById('cvUploadStatus');
            const statusText = document.getElementById('statusText');
            const spinner = document.getElementById('cvSpinner');
            const successIcon = document.getElementById('cvSuccessIcon');
            const btn = document.getElementById('btnUploadCv');

            statusDiv.classList.remove('d-none');
            spinner.classList.remove('d-none');
            successIcon.classList.add('d-none');
            statusText.innerText = "AI đang phân tích CV...";
            btn.disabled = true;

            const formData = new FormData();
            formData.append('employee_id', '@(profile?.Id ?? 0)');
            formData.append('file', file);
            formData.append('model', 'vi-ateam');

            try {
                const aiCoreUrl = '@(Configuration["AiCore:BaseUrl"] ?? "http://localhost:8001")'.replace(/\/+$/, '');
                const response = await fetch(`${aiCoreUrl}/process-cv-full`, {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const error = await response.json().catch(() => ({}));
                    throw new Error(error.detail || "Không thể phân tích CV");
                }

                const result = await response.json();
                spinner.classList.add('d-none');
                successIcon.classList.remove('d-none');
                statusText.innerText = "Phân tích hoàn tất!";

                if (window.showToast) window.showToast(`AI đã nhận diện hồ sơ: ${result.category || 'Hoàn tất'}`, "success");
                setTimeout(() => location.reload(), 800);
            } catch (err) {
                console.error(err);
                statusText.innerText = "Phân tích thất bại!";
                spinner.classList.add('d-none');
                successIcon.classList.add('d-none');
                if (window.showToast) window.showToast("Lỗi: " + err.message, "danger");
                setTimeout(() => statusDiv.classList.add('d-none'), 3000);
            } finally {
                btn.disabled = false;
            }
        };

        // Resume deletion
        const btnConfirmDeleteResume = document.getElementById("btnConfirmDeleteResume");
        const deleteResumeSpinner = document.getElementById("deleteResumeSpinner");
        const deleteResumeModalEl = document.getElementById("deleteResumeModal");

        if (btnConfirmDeleteResume) {
            btnConfirmDeleteResume.addEventListener("click", async () => {
                btnConfirmDeleteResume.disabled = true;
                deleteResumeSpinner.classList.remove("d-none");

                try {
                    const response = await fetch('/Resume/DeleteResume', { method: 'POST' });
                    if (!response.ok) throw new Error("Không thể xóa CV. Vui lòng thử lại!");

                    bootstrap.Modal.getInstance(deleteResumeModalEl)?.hide();
                    if (window.showToast) window.showToast("Đã xóa CV thành công!", "success");
                    setTimeout(() => location.reload(), 600);
                } catch (error) {
                    console.error("Lỗi:", error);
                    if (window.showToast) window.showToast(error.message || "Lỗi kết nối máy chủ!", "danger");
                } finally {
                    btnConfirmDeleteResume.disabled = false;
                    deleteResumeSpinner.classList.add("d-none");
                }
            });
        }
    </script>
}