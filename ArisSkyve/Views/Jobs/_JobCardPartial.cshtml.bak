@model IEnumerable<ArisSkyve.Domain.Entities.JobPosting>

@if (Model != null)
{
    var jobIndex = 0;
    foreach (var job in Model)
    {
        var isNew = job.CreatedAt >= DateTime.UtcNow.AddDays(-3);
        var companyName = job.BusinessAccount?.CompanyName ?? job.Company;
        var avatarUrl = job.BusinessAccount?.AvatarUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(companyName)}&background=2F6FED&color=fff&size=96";
        var primaryLocation = job.Locations?.FirstOrDefault()?.Address ?? (string.IsNullOrWhiteSpace(job.Locations?.FirstOrDefault()?.City) ? "Toàn quốc" : job.Locations?.FirstOrDefault()?.City);
        var filterText = string.Join(" ", new[] { job.Title, companyName, job.WorkTime, job.Category, primaryLocation }.Where(s => !string.IsNullOrWhiteSpace(s))).ToLowerInvariant();

        <div class="card job-card p-3 mb-3 border-0 shadow-sm" data-filter-text="@filterText" style="animation-delay:@(Math.Min(jobIndex++, 6) * 0.05)s">
            <div class="d-flex gap-3">
                <div class="company-logo-wrapper flex-shrink-0">
                    <img src="@avatarUrl" alt="@companyName logo" class="img-fluid rounded-3" loading="lazy" onerror="this.src='/images/default-avatar.png';">
                </div>

                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                        <div class="min-w-0">
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="text-decoration-none">
                                <h6 class="fw-bold mb-0 text-dark job-title-link text-truncate">@job.Title</h6>
                            </a>
                            @if (job.BusinessAccountId != null)
                            {
                                <a asp-controller="Company" asp-action="Details" asp-route-id="@job.BusinessAccountId" class="small fw-medium text-muted text-decoration-none d-inline-flex align-items-center mt-1 text-truncate">
                                    <i data-lucide="building" class="me-1 text-primary" style="width: 14px; height: 14px;"></i>
                                    @companyName
                                </a>
                            }
                            else
                            {
                                <span class="small fw-medium text-muted d-inline-flex align-items-center mt-1 text-truncate">
                                    <i data-lucide="building" class="me-1 text-primary" style="width: 14px; height: 14px;"></i>
                                    @companyName
                                </span>
                            }
                        </div>
                        @if (isNew)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small fw-semibold flex-shrink-0">
                                Mới
                            </span>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 my-2">
                        <span class="job-meta-pill">
                            <i data-lucide="map-pin" style="width: 13px; height: 13px;"></i>
                            <span class="text-truncate" style="max-width: 220px;">@primaryLocation</span>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(job.WorkTime))
                        {
                            <span class="job-meta-pill">
                                <i data-lucide="briefcase" style="width: 13px; height: 13px;"></i>
                                @job.WorkTime
                            </span>
                        }
                        <span class="job-meta-pill">
                            <i data-lucide="clock" style="width: 13px; height: 13px;"></i>
                            @job.CreatedAt.ToString("dd/MM/yyyy")
                        </span>
                        @if (job.Deadline.HasValue)
                        {
                            <span class="job-meta-pill text-warning-emphasis">
                                <i data-lucide="calendar-alert" style="width: 13px; height: 13px;"></i>
                                Hạn: @job.Deadline.Value.ToString("dd/MM/yyyy")
                            </span>
                        }
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-2 border-top border-light-subtle">
                        <span class="salary-tag">
                            <i data-lucide="wallet" style="width: 14px; height: 14px;"></i>
                            @(string.IsNullOrWhiteSpace(job.Salary) ? "Thỏa thuận" : job.Salary)
                        </span>

                        <div class="d-flex gap-2">
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id"
                               class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                                Chi tiết
                            </a>
                            @if (ViewContext.ViewData["UserRole"]?.ToString() != "Business")
                            {
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id"
                                   class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold apply-cta d-inline-flex align-items-center">
                                    Ứng tuyển <i data-lucide="arrow-right" class="ms-1" style="width: 14px; height: 14px;"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<style>
    .job-card {
        border-radius: 16px;
        background: rgba(15, 24, 47, 0.62);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.10) !important;
        transition: transform 0.2s cubic-bezier(.22, 1, .36, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .job-card:hover {
        transform: translateY(-2px);
        border-color: rgba(126, 200, 245, 0.4) !important;
        box-shadow: 0 18px 44px -14px rgba(2, 5, 14, 0.85), 0 0 30px -8px rgba(47, 111, 237, 0.4) !important;
    }

    .company-logo-wrapper {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        overflow: hidden;
    }

    .company-logo-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .job-title-link {
        color: #EDF2FA;
        font-size: 15.5px;
        line-height: 1.35;
        transition: color 0.15s ease;
    }

    .job-title-link:hover {
        color: #7EC8F5 !important;
    }

    .job-meta-pill {
        font-size: 12px;
        color: #8CA0BC;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 999px;
        padding: 3px 10px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

    .salary-tag {
        font-weight: 700;
        color: #6EE7B7;
        background: rgba(52, 211, 153, 0.12);
        border: 1px solid rgba(52, 211, 153, 0.3);
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .apply-cta {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .apply-cta:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(47, 111, 237, 0.5);
    }
</style>
