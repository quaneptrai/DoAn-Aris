@model ArisSkyve.ViewComponents.AppNavbarViewModel

<nav class="navbar navbar-expand-lg @(Model.Theme == "dark" ? "navbar-cockpit" : "")">
    <div class="container">
        <div class="d-flex align-items-center">
            <a asp-controller="Dashboard" asp-action="Index" class="logo me-3 d-flex align-items-center gap-2">
                <svg width="26" height="26" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <linearGradient id="navLogoGradient" x1="0%" y1="100%" x2="100%" y2="0%">
                            <stop offset="0%" style="stop-color: var(--accent)"/>
                            <stop offset="100%" style="stop-color: var(--accent-light)"/>
                        </linearGradient>
                    </defs>
                    <path d="M 30,145 C 65,180 125,160 120,115 C 115,70 70,70 70,115 C 70,150 115,95 170,30" fill="none" stroke="url(#navLogoGradient)" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Aris</span>
            </a>
            <div class="search-wrap d-none d-md-block">
                <div class="SearchContainer d-flex">
                    <i data-lucide="search" ></i>
                    <input type="search" id="globalSearchInput" class="form-control search-input" placeholder="Tìm việc làm, công ty, kết nối..." aria-label="Tìm kiếm trên Aris" aria-controls="globalSearchResults" aria-expanded="false" autocomplete="off">
                </div>
                <div class="global-search-results" id="globalSearchResults"></div>
            </div>
        </div>

        <div class="ms-auto d-flex align-items-center">
            <ul class="navbar-nav flex-row gap-2">
                <li class="nav-item @(Model.Active == "Home" ? "active" : "")">
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link"><i data-lucide="home" ></i><span>Trang chủ</span></a>
                </li>
                <li class="nav-item @(Model.Active == "Network" ? "active" : "")">
                    <a asp-controller="Chat" asp-action="Index" class="nav-link"><i data-lucide="users" ></i><span>Kết nối</span></a>
                </li>
                @if (Model.Role == "Business")
                {
                    <li class="nav-item @(Model.Active == "Dashboard" || Model.Active == "Employer" ? "active" : "")">
                        <a asp-controller="Employer" asp-action="Index" class="nav-link"><i data-lucide="gauge" ></i><span>Tổng quan</span></a>
                    </li>
                }
                <li class="nav-item @(Model.Active == "Jobs" ? "active" : "")">
                    <a asp-controller="Jobs" asp-action="Index" class="nav-link"><i data-lucide="briefcase" ></i><span>Việc làm</span></a>
                </li>
                <li class="nav-item @(Model.Active == "Companies" ? "active" : "")">
                    <a asp-controller="Company" asp-action="Index" class="nav-link"><i data-lucide="building" ></i><span>Doanh nghiệp</span></a>
                </li>
                @await Html.PartialAsync("_NotificationBellNavItem")
                <li class="nav-item dropdown ms-2">
                    <button type="button" class="nav-link p-0 border-0 bg-transparent" data-bs-toggle="dropdown" aria-label="Menu tài khoản" aria-expanded="false">
                        <img id="navAvatar" src="@Model.AvatarUrl" class="rounded-circle" width="34" height="34"
                             alt="Ảnh đại diện" style="object-fit:cover; border: 2px solid rgba(126, 200, 245, 0.45); box-shadow: 0 0 14px rgba(47, 111, 237, 0.45);">
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-3 rounded-3">
                        <li><a class="dropdown-item py-2 fw-medium" asp-controller="Profile" asp-action="Index"><i data-lucide="user" class="me-2" ></i>Hồ sơ cá nhân</a></li>
                        @if (Model.Role == "Business")
                        {
                            <li><a class="dropdown-item py-2 fw-medium" asp-controller="Employer" asp-action="Index"><i data-lucide="gauge" class="me-2" ></i>Bảng điều khiển tuyển dụng</a></li>
                            <li><a class="dropdown-item py-2 fw-medium" asp-controller="Jobs" asp-action="Index"><i data-lucide="briefcase" class="me-2" ></i>Quản lý tin tuyển dụng</a></li>
                            <li><a class="dropdown-item py-2 fw-medium" asp-controller="Company" asp-action="Edit"><i data-lucide="building" class="me-2" ></i>Hồ sơ doanh nghiệp</a></li>
                        }
                        <li><a class="dropdown-item py-2 fw-medium" asp-controller="Settings" asp-action="Index"><i data-lucide="settings" class="me-2" ></i>Cài đặt tài khoản</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item py-2 fw-medium text-danger">Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

@if (Model.IncludeChatWidget)
{
    @await Html.PartialAsync("_ChatWidget", Model.UserId)
}

<script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>
<script>
    // Runs once on load, then keeps watching: every view on this site injects
    // <i data-lucide> markup dynamically after load (chat messages arriving over
    // SignalR, AJAX-rendered job/candidate cards, infinite scroll...), and lucide
    // only ever converts what's in the DOM at the moment createIcons() is called.
    // Without this observer, every icon added after the initial page load would
    // stay a blank <i> tag forever.
    document.addEventListener("DOMContentLoaded", function () {
        if (!window.lucide) return;
        lucide.createIcons();

        let pending = false;
        const observer = new MutationObserver(function (mutations) {
            if (pending) return;
            const hasNewIcon = mutations.some(m => Array.from(m.addedNodes).some(function (node) {
                if (node.nodeType !== 1) return false;
                return node.matches?.("i[data-lucide]") || node.querySelector?.("i[data-lucide]");
            }));
            if (!hasNewIcon) return;
            pending = true;
            requestAnimationFrame(function () {
                lucide.createIcons();
                pending = false;
            });
        });
        observer.observe(document.body, { childList: true, subtree: true });
    });
</script>
<script>
    (function () {
        const input = document.getElementById("globalSearchInput");
        const results = document.getElementById("globalSearchResults");
        if (!input || !results) return;

        function escapeHtml(str) {
            const div = document.createElement("div");
            div.innerText = str == null ? "" : str;
            return div.innerHTML;
        }

        function sectionHtml(title, items, renderItem) {
            if (!items || items.length === 0) return "";
            return `<div class="gs-section-title">${title}</div>` + items.map(renderItem).join("");
        }

        function render(data) {
            const jobsHtml = sectionHtml("Việc làm", data.jobs, j => `
                <a class="gs-item" href="/Jobs/Details/${j.id}">
                    <span class="gs-icon"><i data-lucide="briefcase" ></i></span>
                    <div class="gs-item-meta">
                        <div class="gs-item-title">${escapeHtml(j.title)}${j.isActive === false ? ' <span class="badge bg-secondary" style="font-size:9px;">Hết hạn</span>' : ''}</div>
                        <div class="gs-item-sub">${escapeHtml(j.company)}${j.salary ? " · " + escapeHtml(j.salary) : ""}</div>
                    </div>
                </a>`);

            const companiesHtml = sectionHtml("Doanh nghiệp", data.companies, c => `
                <a class="gs-item" href="/Company/Details/${c.id}">
                    <img src="${c.avatar || ("https://ui-avatars.com/api/?name=" + encodeURIComponent(c.name) + "&background=2F6FED&color=fff")}">
                    <div class="gs-item-meta">
                        <div class="gs-item-title">${escapeHtml(c.name)}</div>
                        <div class="gs-item-sub">${escapeHtml(c.industry || "Doanh nghiệp")}</div>
                    </div>
                </a>`);

            const peopleHtml = sectionHtml("Thành viên", data.people, p => `
                <a class="gs-item" href="/Chat/Index?userId=${p.id}">
                    <img src="${p.avatar || "/images/default-avatar.png"}" style="border-radius:50%;">
                    <div class="gs-item-meta">
                        <div class="gs-item-title">${escapeHtml(p.username)}</div>
                        <div class="gs-item-sub">Nhắn tin</div>
                    </div>
                </a>`);

            const combined = jobsHtml + companiesHtml + peopleHtml;
            results.innerHTML = combined || '<div class="gs-empty">Không tìm thấy kết quả phù hợp.</div>';
            results.classList.add("show");
            input.setAttribute("aria-expanded", "true");
            if (window.lucide) lucide.createIcons();
        }

        let debounceTimer = null;
        let searchRequest = null;
        input.addEventListener("input", () => {
            clearTimeout(debounceTimer);
            searchRequest?.abort();
            results.classList.remove("show");
            input.setAttribute("aria-expanded", "false");
            const q = input.value.trim();
            if (!q) {
                results.classList.remove("show");
                results.innerHTML = "";
                return;
            }
            debounceTimer = setTimeout(async () => {
                const request = new AbortController();
                searchRequest = request;
                try {
                    const res = await fetch(`/Search/Global?q=${encodeURIComponent(q)}`, { signal: request.signal });
                    if (!res.ok) throw new Error('Search unavailable');
                    const data = await res.json();
                    if (input.value.trim() === q && !request.signal.aborted) render(data);
                } catch (error) {
                    if (error.name === 'AbortError' || request.signal.aborted) return;
                    results.innerHTML = '<div class="gs-empty" role="status">Chưa thể tìm kiếm. Vui lòng thử lại.</div>';
                    results.classList.add('show');
                    input.setAttribute('aria-expanded', 'true');
                }
            }, 250);
        });

        input.addEventListener("focus", () => {
            if (input.value.trim() && results.innerHTML) { results.classList.add("show"); input.setAttribute("aria-expanded", "true"); }
        });

        document.addEventListener("click", (e) => {
            if (!results.contains(e.target) && e.target !== input) {
                results.classList.remove("show");
                input.setAttribute("aria-expanded", "false");
            }
        });
        document.addEventListener("keydown", e => {
            if (e.key === "Escape" && results.classList.contains("show")) {
                results.classList.remove("show");
                input.setAttribute("aria-expanded", "false");
                input.focus();
            }
            if (e.key === "ArrowDown" && (e.target === input || results.contains(e.target))) {
                const items = [...results.querySelectorAll('a')];
                if (!items.length || !results.classList.contains('show')) return;
                e.preventDefault();
                items[(items.indexOf(document.activeElement) + 1) % items.length].focus();
            }
        });
    })();
</script>

