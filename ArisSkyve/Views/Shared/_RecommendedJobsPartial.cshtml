@model List<ArisSkyve.Application.DTOs.JobRecommendationDTO>
@using ArisSkyve.Infrastructure.Services.Recruitment

@{
    var ringRadius = 22;
    var ringCircumference = 2 * Math.PI * ringRadius;
    string ScoreTier(double? s) => s.HasValue ? (s.Value >= 80 ? "high" : (s.Value >= 60 ? "mid" : "low")) : "none";
    string Initials(string? name)
    {
        var words = (name ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length == 0 ? "AR" : words.Length == 1 ? words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant() : string.Concat(words[0][0], words[1][0]).ToUpperInvariant();
    }
    int Tone(string? name)
    {
        uint hash = 0;
        foreach (var character in name ?? "") hash = unchecked(hash * 31 + character);
        return (int)(hash % 6) + 1;
    }
    var jsonOpts = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
}

@if (Model != null && Model.Any())
{
    @if (ViewData["IsFallbackCache"] as bool? == true && ViewData["FallbackNotice"] != null)
    {
        <div class="rec-notice rec-notice--warn">
            <i data-lucide="clock" class="flex-shrink-0"></i>
            <span>@ViewData["FallbackNotice"]</span>
        </div>
    }
    @if (ViewData["IsDegraded"] as bool? == true)
    {
        <div class="rec-notice">
            <i data-lucide="info" class="flex-shrink-0"></i>
            <span>Kết quả tạm thời — AI đang quá tải, Aris sẽ tự tính lại sau ít phút.</span>
        </div>
    }
    var topCategory = Model.OrderByDescending(x => x.Score.HasValue).ThenByDescending(x => x.Score).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.Category))?.Category;
    if (!string.IsNullOrWhiteSpace(topCategory))
    {
        <div id="ai-suggested-category" data-category="@topCategory" class="d-none"></div>
    }
    var itemIndex = 0;
    @foreach (var item in Model)
    {
        var hasScore = item.Score.HasValue;
        var score = hasScore ? Math.Clamp(item.Score!.Value, 0, 100) : 0;
        var offset = ringCircumference * (1 - score / 100.0);
        var tier = ScoreTier(item.Score);
        var matched = item.MatchedSkills ?? new List<string>();
        var missing = item.MissingSkills ?? new List<string>();
        // Một dòng ngắn ở thẻ ngoài; chi tiết (khớp/thiếu, trích dẫn, sửa CV, nên học gì) nằm trong ngăn "Vì sao?".
        var summary = MatchInsight.BuildSummary(matched, missing, item.Reason);
        var detail = new MatchDetail
        {
            Score = item.Score,
            Reason = item.Reason,
            Advice = item.Advice,
            Matched = matched,
            Missing = missing,
            ExplanationStatus = item.ExplanationStatus,
            Evidence = (item.Evidence ?? new List<ArisSkyve.Application.DTOs.AiRecommendationEvidenceDto>())
                .Select(e => new MatchEvidence { Cv = e.CvQuote, Job = e.JobQuote }).ToList()
        };
        var insightJson = System.Text.Json.JsonSerializer.Serialize(new
        {
            jobId = item.Id,
            jobTitle = item.JobTitle,
            company = item.Company,
            score = item.Score,
            tier = MatchInsight.Tier(item.Score).Key,
            tierLabel = MatchInsight.Tier(item.Score).Label,
            summary,
            reason = item.Reason,
            advice = item.Advice,
            matched,
            missing,
            evidence = detail.Evidence.Select(e => new { cv = e.Cv, job = e.Job }),
            explanationStatus = item.ExplanationStatus,
            cvSuggestions = MatchInsight.CvSuggestions(detail, item.JobTitle)
        }, jsonOpts);

        <div class="ai-recommend-card" data-rec-json="@insightJson" style="animation-delay:@(Math.Min(itemIndex++, 6) * 0.06)s">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="d-flex gap-3 min-w-0">
                    <div class="rec-logo"><span class="a-logo a-logo--44" data-tone="@Tone(item.Company ?? item.JobTitle)">@Initials(item.Company ?? item.JobTitle)</span></div>
                    <div class="min-w-0">
                        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@item.Id" class="rec-title">@item.JobTitle</a>
                        <p class="rec-company">@item.Company@(string.IsNullOrWhiteSpace(item.Category) ? "" : " · " + item.Category)</p>
                    </div>
                </div>

                <div class="match-ring-wrap match-ring-@tier" title="Điểm phù hợp với CV (0–100)">
                    <svg width="52" height="52" viewBox="0 0 56 56">
                        <circle class="match-ring-track" cx="28" cy="28" r="@ringRadius" fill="none" stroke-width="5"></circle>
                        @if (hasScore)
                        {
                            <circle class="match-ring-fill" cx="28" cy="28" r="@ringRadius" fill="none" stroke-width="5"
                                    stroke-dasharray="@ringCircumference.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    style="--ring-offset:@offset.ToString(System.Globalization.CultureInfo.InvariantCulture)px"></circle>
                        }
                    </svg>
                    <span class="match-ring-value">@if (hasScore) { @Math.Round(score)<small>/100</small> } else { <text>—</text> }</span>
                </div>
            </div>

            <div class="rec-foot mt-2">
                @if (!string.IsNullOrWhiteSpace(summary))
                {
                    <p class="rec-summary small mb-0" title="@summary">@summary</p>
                }
                else
                {
                    <span class="rec-summary small mb-0">@MatchInsight.Tier(item.Score).Label</span>
                }
                <button type="button" class="rec-why" data-insight-rec aria-label="Vì sao Aris gợi ý tin @item.JobTitle">
                    Vì sao? <i data-lucide="chevron-right"></i>
                </button>
            </div>
        </div>
    }
}
