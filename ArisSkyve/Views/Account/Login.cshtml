@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Đăng nhập — Aris Careers";
    ViewData["ReturnView"] = "Login";
    var submittedEmail = ViewBag.SubmittedEmail as string;
    var hasSentLink = !string.IsNullOrEmpty(ViewBag.Message as string);
    var returnUrl = ViewBag.ReturnUrl as string;
    var error = ViewBag.Error as string;
}

@if (hasSentLink)
{
    @await Html.PartialAsync("_AuthSent")
}
else
{
    <section class="auth-card" aria-labelledby="authTitle">
        <header class="auth-head">
            <span class="auth-mark" aria-hidden="true">@await Html.PartialAsync("_ArisMark", 30)</span>
            <h1 class="auth-title" id="authTitle">Chào mừng trở lại</h1>
            <p class="auth-sub">Đăng nhập để xem việc mới, tin nhắn từ nhà tuyển dụng và những đơn bạn đã nộp.</p>
        </header>

        <nav class="auth-tabs" aria-label="Đăng nhập hoặc tạo tài khoản">
            <span class="auth-tabs__thumb" aria-hidden="true"></span>
            <a class="auth-tab" asp-action="Login" asp-route-returnUrl="@returnUrl" aria-current="page"><i data-lucide="log-in"></i>Đăng nhập</a>
            <a class="auth-tab" asp-action="Register" asp-route-returnUrl="@returnUrl"><i data-lucide="user-plus"></i>Tạo tài khoản</a>
        </nav>

        @if (error != null)
        {
            <div class="auth-alert" role="alert"><i data-lucide="alert-circle"></i><span>@error</span></div>
        }

        @await Html.PartialAsync("_AuthSocial", (string?)null)

        <div class="auth-sep"><span>hoặc tiếp tục với email</span></div>

        <form asp-action="RequestMagicLink" method="post" class="auth-form" id="authForm" novalidate>
            <input type="hidden" name="returnView" value="Login" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <label class="auth-field" for="authEmail">
                <span class="auth-field__row">
                    <span class="a-label">Email</span>
                    <span class="auth-ok" id="authEmailOk" hidden><i data-lucide="check-circle-2"></i>Hợp lệ</span>
                </span>
                <span class="auth-input">
                    <i data-lucide="mail"></i>
                    <input type="email" name="email" id="authEmail" placeholder="ten@congty.com" value="@submittedEmail" autocomplete="email" inputmode="email" required autofocus aria-describedby="authEmailHint authNote" />
                </span>
                <span class="auth-hint" id="authEmailHint" hidden>Email chưa đúng định dạng, ví dụ: ten@congty.com</span>
            </label>
            <p class="auth-note" id="authNote"><i data-lucide="shield-check"></i><span>Không cần mật khẩu. Aris gửi một liên kết đăng nhập tới email này, hết hạn sau 30 phút.</span></p>
            <button class="a-btn a-btn--sunset auth-submit" type="submit" id="authSubmit">
                <span>Gửi liên kết đăng nhập</span><i data-lucide="arrow-right"></i>
            </button>
            <p class="auth-legal">Bằng việc tiếp tục, bạn đồng ý với <b>Điều khoản sử dụng</b> và <a href="/privacy"><b>Chính sách quyền riêng tư</b></a> của Aris.</p>
        </form>

        <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register" asp-route-returnUrl="@returnUrl">Tạo tài khoản</a></p>

        @if (Env.IsDevelopment())
        {
            <div class="auth-dev">
                <div class="auth-dev__head"><i data-lucide="flask-conical"></i>Đăng nhập nhanh · chỉ ở môi trường phát triển</div>
                <div class="auth-dev__row">
                    <form asp-action="DirectLogin" method="post">
                        <input type="hidden" name="email" value="ungvien@aris.vn" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="auth-dev__btn"><i data-lucide="user-round"></i>Ứng viên mẫu</button>
                    </form>
                    <form asp-action="DirectLogin" method="post">
                        <input type="hidden" name="email" value="hr@technova.example.com" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="auth-dev__btn"><i data-lucide="building-2"></i>Doanh nghiệp mẫu</button>
                    </form>
                </div>
                <form asp-action="DirectLogin" method="post" class="auth-dev__email">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input class="a-input" type="email" name="email" placeholder="…hoặc nhập email bất kỳ (vd. tài khoản của bạn)" aria-label="Email đăng nhập nhanh" autocomplete="email" required />
                    <button type="submit" class="auth-dev__btn">Vào</button>
                </form>
            </div>
        }
    </section>
}

@section Scripts {
    <script src="~/js/pages/auth.js" asp-append-version="true"></script>
}
