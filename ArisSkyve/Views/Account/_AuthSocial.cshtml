@* Mạng xã hội dùng POST + antiforgery; trạng thái đồng ý được xác thực lại ở server và mang trong OAuth state. *@
@model string?
<div class="auth-social">
    <form asp-controller="Account" asp-action="GoogleLogin" method="post" data-auth-social-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="AcceptTerms" value="false" data-auth-terms-value />
        <input type="hidden" name="intent" value="@Model" data-auth-intent />
        <input type="hidden" name="returnView" value="@(ViewData["ReturnView"] as string ?? "Login")" />
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <button class="auth-social__btn" type="submit">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" />
                <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" />
                <path fill="#FBBC05" d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z" />
                <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 7.294C4.672 5.167 6.656 3.58 9 3.58z" />
            </svg>
            <span>Google</span>
        </button>
    </form>
    <form asp-controller="Account" asp-action="FacebookLogin" method="post" data-auth-social-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="AcceptTerms" value="false" data-auth-terms-value />
        <input type="hidden" name="intent" value="@Model" data-auth-intent />
        <input type="hidden" name="returnView" value="@(ViewData["ReturnView"] as string ?? "Login")" />
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <button class="auth-social__btn" type="submit">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                <path fill="#1877F2" d="M18 9a9 9 0 1 0-10.406 8.89v-6.29H5.31V9h2.284V7.017c0-2.255 1.343-3.501 3.4-3.501.985 0 2.014.176 2.014.176v2.215h-1.135c-1.118 0-1.467.694-1.467 1.406V9h2.497l-.4 2.6h-2.097v6.29A9.002 9.002 0 0 0 18 9z" />
            </svg>
            <span>Facebook</span>
        </button>
    </form>
</div>
