/* Aris Dashboard — Constellation System Styles */
.dashboard-page {
  max-width: 1400px;
  width: 95%;
  margin: 0 auto;
  padding-top: 36px;
  padding-bottom: 48px;
}

.dashboard-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  padding-bottom: 32px;
}
.dashboard-heading p {
  color: #93C5FD;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin: 0 0 8px;
}
.dashboard-heading h1 {
  font-family: 'Space Grotesk', system-ui, sans-serif !important;
  font-size: 36px;
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1.25;
  margin: 0 0 10px;
  background: linear-gradient(135deg, #FFFFFF 20%, #DBEAFE 65%, #60A5FA 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  display: inline-block;
}
.dashboard-heading .dashboard-subtitle {
  color: #8BA2C4;
  font-size: 13px;
  margin: 0;
}

.dashboard-explore {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  color: #DBEAFE;
  text-decoration: none;
  border: 1px solid rgba(147, 197, 253, 0.30);
  border-top: 1px solid rgba(255, 255, 255, 0.40);
  padding: 10px 18px;
  border-radius: 12px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  font-weight: 600;
  background: rgba(16, 25, 45, 0.65);
  backdrop-filter: blur(12px);
  box-shadow: 0 0 20px rgba(37, 99, 235, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  transition: all 180ms var(--ease-settle);
}
.dashboard-explore:hover {
  color: #FFFFFF;
  border-color: rgba(191, 219, 254, 0.65);
  transform: translateY(-2px);
  box-shadow: 0 0 28px rgba(59, 130, 246, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.3);
}
.dashboard-explore svg {
  width: 17px;
  height: 17px;
  transition: transform 200ms var(--ease-settle);
}
.dashboard-explore:hover svg {
  transform: translate(2px, -2px);
}

.dashboard-reminder {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0 0 24px;
  padding: 14px 18px;
  border: 1px solid rgba(147, 197, 253, 0.25);
  border-radius: 12px;
  background: rgba(14, 22, 38, 0.65);
  backdrop-filter: blur(12px);
  font-size: 13px;
  color: #C8E1FF;
  text-decoration: none;
}
.dashboard-reminder svg {
  width: 18px;
  height: 18px;
  color: #7EC8F5;
}

.dash-workspace-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 350px;
  gap: 32px;
  align-items: start;
}
.dash-center-feed, .dash-right-rail { min-width: 0; }
.dash-rail-sticky { position: sticky; top: 88px; }

/* Profile Rail Card */
.profile-rail-card {
  background: linear-gradient(145deg, rgba(16, 25, 45, 0.75) 0%, rgba(9, 15, 30, 0.90) 100%) !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-top: 1px solid rgba(147, 197, 253, 0.22) !important;
  border-radius: 16px;
  box-shadow: var(--cosmos-shadow-card);
  backdrop-filter: blur(16px);
  overflow: hidden;
  margin-bottom: 16px;
}
.profile-rail-cover {
  height: 52px;
  background: linear-gradient(130deg, rgba(37, 99, 235, 0.35), rgba(14, 22, 38, 0.1));
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
.profile-rail-body {
  position: relative;
  margin-top: -26px;
  padding: 0 20px 20px;
}
.profile-rail-avatar {
  width: 50px;
  height: 50px;
  border-radius: 14px;
  object-fit: cover;
  border: 2px solid #7EC8F5;
  box-shadow: 0 0 16px rgba(47, 111, 237, 0.45);
  margin-bottom: 12px;
}
.profile-rail-name {
  font-family: 'Space Grotesk', sans-serif !important;
  font-size: 16px;
  font-weight: 650;
  color: #F0F6FF;
  margin: 0 0 4px;
}
.profile-rail-title {
  font-size: 11px;
  color: #93C5FD;
  display: block;
  margin-bottom: 12px;
}
.profile-rail-bio {
  font-size: 12px;
  color: #8BA2C4;
  line-height: 1.7;
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.profile-stat-box {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  padding: 12px 0;
  margin-bottom: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}
.profile-rail-body .btn {
  border-radius: 9px !important;
  font-size: 12px;
  min-height: 36px;
  height: 36px;
}

/* Workspace Navigation Links */
.workspace-links {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 0 6px 20px;
  margin-bottom: 4px;
}
.workspace-links a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 10px;
  color: #9FB3CE;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
  border-radius: 9px;
  transition: all 140ms ease;
}
.workspace-links a:hover {
  color: #FFFFFF;
  background: rgba(47, 111, 237, 0.12);
}
.workspace-links svg {
  width: 17px;
  height: 17px;
  color: #7EC8F5;
}
.workspace-links a > svg:last-child,
.workspace-links a > span:last-child {
  margin-left: auto;
  width: 14px;
  color: #64748B;
}

/* Feed Composer Card */
.feed-composer-card {
  position: relative;
  padding: 22px 24px 14px;
  margin-bottom: 32px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-top: 1px solid rgba(147, 197, 253, 0.25);
  border-radius: 16px;
  background: linear-gradient(145deg, rgba(16, 25, 45, 0.72) 0%, rgba(9, 15, 30, 0.86) 100%);
  backdrop-filter: blur(18px);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.45), 0 0 35px rgba(37, 99, 235, 0.05);
  transition: border-color 180ms ease, box-shadow 180ms ease;
}
.feed-composer-card.is-expanded {
  border-color: rgba(147, 197, 253, 0.45);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.55), 0 0 40px rgba(47, 111, 237, 0.14);
}
.composer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: #93C5FD;
}
.composer-collapse {
  width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: #8BA2C4;
  opacity: 0;
  visibility: hidden;
  border-radius: 6px;
  transition: opacity 160ms ease;
}
.composer-collapse svg { width: 15px; height: 15px; }
.is-expanded .composer-collapse { opacity: 1; visibility: visible; }
.composer-collapse:hover { background: rgba(255, 255, 255, 0.08); }

.composer-textarea {
  width: 100%;
  min-height: 36px;
  height: 38px;
  max-height: 320px;
  resize: none;
  border: 0;
  outline: 0;
  padding: 8px 0;
  background: transparent;
  color: #E2E8F0;
  font-size: 14px;
  line-height: 1.7;
  transition: height 260ms var(--ease-settle);
}
.composer-textarea::placeholder {
  color: #7E92AB;
}
.composer-textarea:focus-visible { outline: 0; }

.composer-details {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition: grid-template-rows 260ms var(--ease-settle), opacity 160ms ease;
}
.composer-details-inner { min-height: 0; overflow: hidden; }
.is-expanded .composer-details { grid-template-rows: 1fr; opacity: 1; }

.composer-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  padding-top: 14px;
  padding-bottom: 6px;
  margin-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}
.composer-attach-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 0;
  padding: 7px 10px;
  border-radius: 8px;
  color: #9FB3CE;
  background: transparent;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  transition: background 140ms ease, color 140ms ease;
}
.composer-attach-btn:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #FFFFFF;
}

.btn-composer-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 108px;
  min-height: 36px;
  border: 1px solid rgba(147, 197, 253, 0.40);
  border-top: 1px solid rgba(255, 255, 255, 0.50);
  padding: 8px 16px;
  border-radius: 10px;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 60%, #1E40AF 100%);
  box-shadow: 0 0 18px rgba(37, 99, 235, 0.40), inset 0 1px 0 rgba(255, 255, 255, 0.30);
  color: #FFFFFF;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  font-weight: 600;
  transition: filter 150ms, transform 100ms;
}
.btn-composer-submit:hover { filter: brightness(1.15); transform: translateY(-1px); }
.btn-composer-submit:active { transform: translateY(1px); }
.btn-composer-submit:disabled { opacity: 0.6; }

/* Feed Post Cards */
.feed-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 2px 16px;
}
.feed-heading {
  margin: 0;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: #E9EEF6;
}
.feed-sort-label {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 11px;
  color: #7E92AB;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.post-card {
  padding: 24px;
  margin-bottom: 20px;
  background: linear-gradient(145deg, rgba(16, 25, 45, 0.72) 0%, rgba(9, 15, 30, 0.86) 100%) !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  border-top: 1px solid rgba(147, 197, 253, 0.20) !important;
  border-radius: 16px;
  backdrop-filter: blur(18px);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.40);
  transition: transform 180ms var(--ease-settle),
              border-color 180ms var(--ease-settle),
              box-shadow 180ms var(--ease-settle);
}
.post-card:hover {
  transform: translateY(-2px);
  border-color: rgba(147, 197, 253, 0.32) !important;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.55), 0 0 35px rgba(37, 99, 235, 0.10);
}

.post-author-name {
  color: #F0F6FF;
  text-decoration: none;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 14px;
  font-weight: 600;
}
.post-author-name:hover {
  color: #93C5FD;
}
.post-content-body {
  margin-top: 18px;
  font-size: 14px;
  line-height: 1.85;
  color: #BFCBDB;
  overflow-wrap: anywhere;
}
.post-actions-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 20px;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}
.btn-post-action {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 12px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #94A4BA;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  transition: background-color 140ms ease, color 140ms ease;
}
.btn-post-action:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #F0F6FF;
}
.btn-like.liked {
  color: #F87171;
}
.btn-like.liked svg {
  fill: rgba(248, 113, 113, 0.3);
}

/* Recommended Jobs Rail */
.jobs-rail-card {
  padding: 20px 0 0;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: 20px;
}
.jobs-rail-card h6 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 600;
}
.job-mini-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 10px;
  margin: 0 -10px;
  border-radius: 10px;
  text-decoration: none;
  color: inherit;
  transition: background 150ms ease;
}
.job-mini-item:hover {
  background: rgba(47, 111, 237, 0.10);
}
.job-company-avatar {
  width: 36px;
  height: 36px;
  border: 1px solid rgba(147, 197, 253, 0.25);
  border-radius: 10px;
  display: grid;
  place-items: center;
  color: #93C5FD;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.2), rgba(14, 22, 38, 0.8));
  flex-shrink: 0;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 600;
}
.job-mini-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: #E2E8F0;
  line-height: 1.5;
}
.job-salary-pill {
  display: inline-block;
  font-size: 11px;
  font-weight: 550;
  color: #34D399;
  padding: 2px 0;
  margin-top: 2px;
}

@media (max-width: 991px) {
  .dashboard-page { padding-top: 24px; }
  .dash-workspace-grid { grid-template-columns: minmax(0, 1fr) 240px; gap: 24px; }
  .dash-rail-sticky { top: 132px; }
  .dashboard-heading h1 { font-size: 30px; }
}

@media (max-width: 767px) {
  .dashboard-heading { padding-bottom: 24px; gap: 14px; flex-wrap: wrap; }
  .dashboard-heading h1 { font-size: 28px; }
  .dash-workspace-grid { grid-template-columns: minmax(0, 1fr); }
  .dash-right-rail { display: none; }
  .feed-composer-card { padding: 18px 16px 10px; margin-bottom: 24px; }
  .composer-textarea { font-size: 16px; }
  .post-card { padding: 18px; }
}

/* =========================================================================
   MEDIA LIGHTBOX & COMMENTS MODAL — Elevated Cosmic Experience
   ========================================================================= */
.media-lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 2100 !important;
  background: rgba(4, 8, 20, .88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 32px 24px;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
  cursor: pointer; /* Click backdrop outside modal to exit */
}

.media-lightbox.show {
  display: flex;
  animation: lbModalFadeIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes lbModalFadeIn {
  from { opacity: 0; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}

/* Screen overlay close button */
.lightbox-screen-close {
  position: fixed;
  top: 24px;
  right: 28px;
  z-index: 2050;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(146, 186, 255, .12);
  border: 1px solid rgba(178, 212, 255, .25);
  color: #E6EEFB;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.lightbox-screen-close:hover {
  background: rgba(239, 68, 68, .25);
  border-color: rgba(239, 68, 68, .55);
  color: #FF8585;
  transform: rotate(90deg) scale(1.08);
}

/* Lightbox Container */
.lightbox-container {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 24px;
  max-width: 1400px;
  width: 100%;
  height: 86vh;
  max-height: 860px;
  cursor: default; /* Clicks inside container are normal */
  position: relative;
  z-index: 2010;
}

/* Stage: Media Viewer */
.lightbox-stage {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Panel Header Close Button */
.btn-panel-close {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(178, 212, 255, 0.16);
  color: #94A3B8;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.18s ease;
}

.btn-panel-close:hover {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.45);
  color: #FF8585;
  transform: scale(1.06);
}

/* Panel Styling */
.media-lightbox .lightbox-panel {
  display: flex;
  flex-direction: column;
  background: linear-gradient(168deg, #121a28 0%, #0c121e 100%);
  border: 1px solid rgba(178, 212, 255, .22);
  border-radius: 18px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, .75), 0 0 35px rgba(56, 189, 248, .12);
  overflow: hidden;
  color: var(--cosmos-text-body, #BFCBDB);
  height: 100%;
}

.lightbox-content-section {
  max-height: 240px;
  overflow-y: auto;
  background: rgba(255, 255, 255, 0.02);
}

.lightbox-post-text {
  font-size: 14.5px;
  line-height: 1.65;
  color: #D6E3F5;
  word-break: break-word;
}

.lightbox-post-text strong {
  display: block;
  font-size: 16px;
  color: #FFFFFF !important;
  margin-bottom: 8px;
}

.lightbox-comments-scroll {
  min-height: 180px;
  background: rgba(8, 14, 26, 0.35);
}

.lb-comment-bubble {
  background: rgba(255, 255, 255, 0.045);
  border: 1px solid rgba(178, 212, 255, 0.12);
  border-radius: 14px;
  padding: 10px 14px;
  transition: background 0.15s ease, border-color 0.15s ease;
}

.lb-comment-bubble:hover {
  background: rgba(255, 255, 255, 0.075);
  border-color: rgba(178, 212, 255, 0.22);
}

.lb-comment-user {
  font-size: 13.5px;
  font-weight: 600;
  color: #60A5FA;
}

.lb-comment-time {
  font-size: 11px;
  color: #64748B;
}

.lb-comment-text {
  font-size: 13.5px;
  line-height: 1.55;
  color: #E2E8F0;
  word-break: break-word;
}

.lb-comment-input {
  background: rgba(15, 23, 42, 0.85) !important;
  border: 1px solid rgba(178, 212, 255, 0.2) !important;
  color: #F8FAFC !important;
  font-size: 14px;
  height: 42px;
  transition: all 0.2s ease;
}

.lb-comment-input:focus {
  border-color: #38BDF8 !important;
  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2) !important;
  background: rgba(15, 23, 42, 0.95) !important;
}

.lb-btn-send {
  height: 42px;
  background: linear-gradient(135deg, #2563EB 0%, #0EA5E9 100%) !important;
  border: none !important;
  box-shadow: 0 4px 14px rgba(14, 165, 233, 0.3) !important;
  transition: all 0.2s ease;
}

.lb-btn-send:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(14, 165, 233, 0.45) !important;
}

/* Sizing Modes:
   1) When Media is present (.has-media):
      - Stage is flex: 1 1 auto
      - Panel is comfortable 460px width
   2) When Media is NOT present (comments/text mode):
      - Stage is hidden
      - Container is centered with max-width 760px
      - Panel takes 100% of 760px centered
*/
.media-lightbox.has-media .lightbox-stage {
  display: flex;
}

.media-lightbox.has-media .lightbox-panel {
  flex: 0 0 460px;
  max-width: 460px;
  width: 460px;
}

.media-lightbox:not(.has-media) .lightbox-stage {
  display: none !important;
}

.media-lightbox:not(.has-media) .lightbox-container {
  max-width: 760px;
  width: 100%;
  justify-content: center;
}

.media-lightbox:not(.has-media) .lightbox-panel {
  flex: 1 1 auto;
  max-width: 760px;
  width: 100%;
  margin: 0 auto;
}

@media (max-width: 991px) {
  .media-lightbox {
    padding: 12px;
  }
  .lightbox-container {
    flex-direction: column;
    height: 94vh;
    max-height: 94vh;
    gap: 12px;
  }
  .media-lightbox.has-media .lightbox-stage {
    flex: 0 0 auto;
    max-height: 35vh;
  }
  .media-lightbox.has-media .lightbox-panel {
    flex: 1 1 auto;
    max-width: 100%;
    width: 100%;
  }
  .media-lightbox:not(.has-media) .lightbox-panel {
    max-width: 100%;
    width: 100%;
    height: 100%;
  }
}

